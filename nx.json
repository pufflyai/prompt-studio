{
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.{test,spec}.{ts,tsx,js,jsx}", "!{projectRoot}/**/__tests__/**"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/bunfig.toml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/scripts/build/**/*",
      "{workspaceRoot}/scripts/release/stage-package.ts",
      { "runtime": "bun --version" },
      { "runtime": "node --version" },
      { "runtime": "node -p \"process.platform + '-' + process.arch\"" }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        { "env": "NODE_ENV" },
        { "env": "PSTDIO_API_URL" },
        { "env": "PSTDIO_TERMINAL_WEBSOCKET_URL" }
      ],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.publish"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/scripts/test-setup.ts",
        "{workspaceRoot}/bunfig.toml",
        "{workspaceRoot}/bun.lock",
        {
          "runtime": "bun --version"
        }
      ]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "{workspaceRoot}/biome.json"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.base.json"]
    }
  }
}
