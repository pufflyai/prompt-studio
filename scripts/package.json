{
  "name": "pstdio-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "bun --cwd .. ./scripts/build/build-all.ts",
    "build:host": "bun --cwd .. ./scripts/build/build-compile.ts",
    "lint": "bun run typecheck && biome check .",
    "release:changelog": "bun --cwd .. ./scripts/release/extract-changelog.ts",
    "release:checksums": "bun --cwd .. ./scripts/release/generate-checksums.ts",
    "release:lockfile:sync": "bun --cwd .. ./scripts/release/sync-lockfile-workspace-dependencies.ts",
    "release:platforms:publish": "bun --cwd .. ./scripts/release/publish-platform-packages.ts",
    "release:platforms:scaffold": "bun --cwd .. ./scripts/release/scaffold-platform-packages.ts",
    "release:platforms:sync": "bun --cwd .. ./scripts/release/sync-platform-versions.ts",
    "release:readme": "bun --cwd .. ./scripts/release/sync-package-readme.ts",
    "release:stamp-dates": "bun --cwd .. ./scripts/release/stamp-changelog-dates.ts",
    "release:version": "bash ./release/version.sh",
    "test": "bun test --silent",
    "typecheck": "tsc --noEmit",
    "validate:changesets": "bun --cwd .. ./scripts/release/validate-changesets.ts",
    "verify:boundaries": "bun --cwd .. ./scripts/verify/verify-boundaries.ts",
    "verify:lockfile": "bun --cwd .. ./scripts/verify/verify-lockfile.ts",
    "verify:packages": "bun --cwd .. ./scripts/verify/verify-packages.ts",
    "verify:translations": "bun --cwd .. ./scripts/verify/verify-translations.ts"
  },
  "dependencies": {
    "pstdio-extensions": "workspace:*"
  },
  "devDependencies": {
    "@changesets/config": "3.1.3",
    "@types/bun": "latest",
    "typescript": "6.0.2"
  }
}
