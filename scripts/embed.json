{
  "$comment": "Files that the pstdio CLI binary embeds (Bun --compile). 'globs' captures generated trees (vite output, drizzle migrations); 'files' is the curated allowlist for packaged runtime assets. The build script fails if any 'files' entry is missing or any file under 'noStraysIn' is not listed.",
  "globs": [
    "packages/pstdio-dashboard/dist/**",
    "packages/pstdio-db/drizzle/**",
    "packages/pstdio-db/vendor/**",
    "extensions/harness-claude-code/**",
    "extensions/harness-codex/**",
    "extensions/harness-open-code/**",
    "extensions/pstdio-base-themes/**",
    "extensions/pstdio-planner/**",
    "extensions/pstdio-reports/**",
    "extensions/pstdio-skills/**"
  ],
  "files": [],
  "noStraysIn": ["packages/pstdio/files"],
  "platformBinaries": [
    {
      "pkg": "cli-darwin-arm64",
      "bin": "pstdio"
    },
    {
      "pkg": "cli-darwin-x64",
      "bin": "pstdio"
    },
    {
      "pkg": "cli-linux-x64",
      "bin": "pstdio"
    },
    {
      "pkg": "cli-linux-arm64",
      "bin": "pstdio"
    },
    {
      "pkg": "cli-win-x64",
      "bin": "pstdio.exe"
    },
    {
      "pkg": "cli-win-arm64",
      "bin": "pstdio.exe"
    }
  ],
  "buildTargets": [
    {
      "target": "bun-darwin-arm64",
      "pkg": "cli-darwin-arm64",
      "bin": "pstdio"
    },
    {
      "target": "bun-darwin-x64",
      "pkg": "cli-darwin-x64",
      "bin": "pstdio"
    },
    {
      "target": "bun-linux-x64",
      "pkg": "cli-linux-x64",
      "bin": "pstdio"
    },
    {
      "target": "bun-linux-arm64",
      "pkg": "cli-linux-arm64",
      "bin": "pstdio"
    },
    {
      "target": "bun-windows-x64",
      "pkg": "cli-win-x64",
      "bin": "pstdio.exe"
    },
    {
      "target": "bun-windows-arm64",
      "pkg": "cli-win-arm64",
      "bin": "pstdio.exe"
    }
  ]
}
