# Override the default database and storage paths for local development.
# Copy this file to .env and adjust as needed.
#
# This prevents dev commands (bun run dev, migrations, etc.) from
# touching the production database at ~/.pstdio/pstdio.db.

PSTDIO_DB_PATH=~/.pstdio-dev/pstdio.db
PSTDIO_STORAGE_PATH=~/.pstdio-dev/storage
