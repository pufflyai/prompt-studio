{
  "name": "prompt-studio",
  "private": true,
  "type": "module",
  "author": "Prompt Studio",
  "email": "support@prompt.studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pufflyai/prompt-studio.git"
  },
  "scripts": {
    "validate": "bun run format && bun run lint && bun run build && bun run test",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" lerna run build",
    "analyze-bundle": "lerna run analyze-bundle --stream",
    "test": "lerna run test",
    "test:coverage": "lerna run test:coverage --stream",
    "test:e2e": "bun run --cwd packages/e2e test",
    "lint": "lerna run lint",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "clean": "find . -type d \\( -name node_modules -o -name dist -o -name .cache \\) -prune -exec rm -rf '{}' + && rm -rf .nx",
    "reset": "bun run clean && bun install && bun run build",
    "knip": "knip",
    "setup:demo": "bun run --cwd scripts setup-demo-project",
    "dev": "PSTDIO_DISABLE_EMBED_MANIFEST=1 PSTDIO_DB_PATH=~/.pstdio-dev/pstdio.db PSTDIO_STORAGE_PATH=~/.pstdio-dev/storage PSTDIO_WORKSPACES_DIR=~/.pstdio-dev/workspaces PSTDIO_API_URL=http://localhost:19841 PSTDIO_API_PORT=19841 PSTDIO_DISABLE_API_AUTO_START=1 bun --watch packages/pstdio/src/index.ts -- serve --port 19841 & VITE_API_BASE_URL=http://localhost:19841 bun run --cwd packages/pstdio-dashboard dev & wait",
    "dev:api": "bun run --cwd packages/pstdio-api dev",
    "dev:landing-page": "bun run --cwd clients/landing-page dev",
    "storybook:ui": "bun run --cwd packages/ui storybook",
    "studio:db": "bun run --cwd packages/pstdio-db studio",
    "dev:desktop": "bun run dev",
    "report:e2e": "bun run --cwd packages/e2e report",
    "storybook:dashboard": "bun run --cwd packages/pstdio-dashboard storybook",
    "build-storybook:dashboard": "bun run --cwd packages/pstdio-dashboard build-storybook",
    "changeset": "changeset",
    "release": "bun run build && changeset publish"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "workspaces": [
    "clients/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@changesets/cli": "2.30.0",
    "@types/bun": "1.3.11",
    "@types/node": "25.5.2",
    "cross-env": "10.1.0",
    "knip": "6.3.0",
    "lerna": "9.0.7"
  },
  "packageManager": "bun@1.3.10"
}
