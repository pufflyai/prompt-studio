{
  "name": "pstdio-db",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "analyze-bundle": "bun build ./src/index.ts --outdir ./dist --target bun --metafile=./dist/bundle-meta.json --metafile-md=./dist/bundle-meta.md",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "typecheck": "tsc --noEmit --project ./tsconfig.json",
    "studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "drizzle-zod": "^0.8.3",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.20.0",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  }
}
