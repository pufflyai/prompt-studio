{
  "name": "pstdio-db",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "targets": {
      "test:coverage": {
        "parallelism": false
      }
    }
  },
  "scripts": {
    "vendor:pglite": "bun run scripts/vendor-pglite-assets.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "analyze-bundle": "bun build ./src/index.ts --outdir ./dist --target bun --metafile=./dist/bundle-meta.json --metafile-md=./dist/bundle-meta.md",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "typecheck": "tsc --noEmit --project ./tsconfig.json",
    "studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@types/bun": "1.4.2",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "pstdio-relay": "workspace:*",
    "pstdio-storage": "workspace:*",
    "typescript": "6.0.2",
    "storage-scale-fixture": "workspace:*"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@electric-sql/pglite-icu-full": "0.1.0",
    "@electric-sql/pglite-tools": "0.2.21",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "pglite-previous": "npm:@electric-sql/pglite@0.3.16",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-paths": "workspace:*",
    "pstdio-sync": "workspace:*",
    "pstdio-sync-contracts": "workspace:*",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  }
}
