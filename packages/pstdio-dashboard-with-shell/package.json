{
  "name": "pstdio-dashboard-with-shell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "bun run typecheck && biome check .",
    "test": "bun test --silent --tsconfig-override tsconfig.app.json",
    "test:coverage": "bun test --coverage --tsconfig-override tsconfig.app.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@pstdio/ui": "workspace:*",
    "@tanstack/react-db": "^0.1.74",
    "@tanstack/react-query": "^5.90.21",
    "pstdio-shell": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-scan": "^0.5.6",
    "typescript": "6.0.2",
    "vite": "^7.2.4"
  }
}
