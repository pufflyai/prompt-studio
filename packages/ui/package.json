{
  "name": "@pstdio/ui",
  "version": "0.47.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pufflyai/prompt-studio"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".publish"
  },
  "files": [
    "dist",
    "dist-monaco",
    "examples"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/dist-monaco",
          "{projectRoot}/.publish"
        ]
      }
    }
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rich-text": {
      "import": "./dist/rich-text.js",
      "types": "./dist/rich-text.d.ts"
    },
    "./lazy-markdown-editor": {
      "import": "./dist/lazy-markdown-editor.js",
      "types": "./dist/lazy-markdown-editor.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    },
    "./chat-ui": {
      "import": "./dist/chat-ui.js",
      "types": "./dist/chat-ui.d.ts"
    },
    "./chat-skeleton": {
      "import": "./dist/chat-skeleton.js",
      "types": "./dist/chat-skeleton.d.ts"
    },
    "./diff": {
      "import": "./dist/diff.js",
      "types": "./dist/diff.d.ts"
    },
    "./kanban-renderer": {
      "import": "./dist/kanban-renderer.js",
      "types": "./dist/kanban-renderer.d.ts"
    },
    "./command-form": {
      "import": "./dist/command-form.js",
      "types": "./dist/command-form.d.ts"
    },
    "./param-editor": {
      "import": "./dist/param-editor.js",
      "types": "./dist/param-editor.d.ts"
    },
    "./data-table": {
      "import": "./dist/data-table.js",
      "types": "./dist/data-table.d.ts"
    },
    "./collection-view": {
      "import": "./dist/collection-view.js",
      "types": "./dist/collection-view.d.ts"
    },
    "./mermaid": {
      "import": "./dist/mermaid.js",
      "types": "./dist/mermaid.d.ts"
    },
    "./terminal": {
      "import": "./dist/terminal.js",
      "types": "./dist/terminal.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./monaco/*": "./dist-monaco/*",
    "./canvas": {
      "import": "./dist/canvas.js",
      "types": "./dist/canvas.d.ts"
    },
    "./dependency-timeline": {
      "import": "./dist/dependency-timeline.js",
      "types": "./dist/dependency-timeline.d.ts"
    },
    "./keyframe-timeline": {
      "import": "./dist/keyframe-timeline.js",
      "types": "./dist/keyframe-timeline.d.ts"
    },
    "./dashboard-renderer": {
      "import": "./dist/dashboard-renderer.js",
      "types": "./dist/dashboard-renderer.d.ts"
    },
    "./charts": {
      "import": "./dist/charts.js",
      "types": "./dist/charts.d.ts"
    }
  },
  "scripts": {
    "build": "bun run typegen:tokens && bun run build:monaco && cross-env NODE_ENV=production vite build && rolldown -c rolldown.types.config.ts && bun ../../scripts/build/mark-dts-modules.ts dist && bun ../../scripts/release/stage-package.ts .",
    "build:monaco": "vite build --config vite.monaco.config.ts",
    "visualize-bundle": "bunx vite-bundle-visualizer",
    "lint": "bun run typecheck && biome check .",
    "typegen:tokens": "chakra typegen ./src/theme/theme.ts && rm -f chakra-config.json",
    "test": "bun ../../scripts/test.ts --scope @pstdio/ui",
    "test:coverage": "bun ../../scripts/ci/run-bun-tests.ts --conditions production --coverage",
    "typecheck": "bun check -p tsconfig.build.json && bun check -p tsconfig.examples.json",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.21.0",
    "@emotion/react": "^11.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/onest": "^5.2.11",
    "@fontsource/playfair-display": "^5.2.8",
    "@git-diff-view/file": "^0.1.3",
    "@git-diff-view/react": "^0.1.3",
    "@lexical/code": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@monaco-editor/react": "^4.7.0",
    "@pstdio/sdk": "workspace:*",
    "@tanstack/charts": "1.2.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@types/mdast": "^4.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.3",
    "dompurify": "^3.4.13",
    "katex": "^0.19.0",
    "lexical": "^0.40.0",
    "lucide-react": "^0.564.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "monaco-editor": "^0.55.1",
    "prismjs": "^1.30.0",
    "react-resizable": "^4.0.2",
    "use-stick-to-bottom": "^1.1.3",
    "yjs": "^13.6.29",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "10.1.0",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-file-types": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-test-renderer": "19.2.4",
    "rolldown": "^1.2.11",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "6.0.2",
    "vite": "^8.3.1",
    "@pstdio/canvas": "workspace:*",
    "pstdio-theme": "workspace:*"
  }
}
