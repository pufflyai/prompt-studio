{
  "name": "@pstdio/ui",
  "version": "0.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pufflyai/prompt-studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rich-text": {
      "import": "./dist/rich-text.js",
      "types": "./dist/components/rich-text/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./chat-ui": {
      "import": "./dist/chat-ui.js",
      "types": "./dist/components/chat-ui/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "bun run typegen:tokens && vite build",
    "visualize-bundle": "bunx vite-bundle-visualizer",
    "lint": "biome check .",
    "typegen:tokens": "chakra typegen ./src/theme/theme.ts && rm -f chakra-config.json",
    "test": "bun test --conditions production --silent",
    "perf:chat": "bunx playwright test -c playwright.chat-perf.config.ts",
    "perf:chat:trace": "PLAYWRIGHT_TRACE=on bunx playwright test -c playwright.chat-perf.config.ts",
    "test-storybook": "test-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/onest": "^5.2.11",
    "@fontsource/playfair-display": "^5.2.8",
    "@git-diff-view/file": "^0.1.3",
    "@git-diff-view/react": "^0.1.3",
    "@lexical/code": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/table": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@lexical/yjs": "^0.40.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "date-fns": "^2.30.0",
    "katex": "^0.16.33",
    "lexical": "^0.40.0",
    "lucide-react": "^0.556.0",
    "mermaid": "11.15.0",
    "pstdio-file-types": "workspace:*",
    "prismjs": "^1.30.0",
    "use-stick-to-bottom": "^1.1.3",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.1.9",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.1.10",
    "@storybook/react": "^10.1.9",
    "@storybook/react-vite": "^10.1.9",
    "@storybook/test-runner": "^0.22.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.1.9",
    "typescript": "6.0.2",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
