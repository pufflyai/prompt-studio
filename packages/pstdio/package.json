{
  "name": "pstdio",
  "version": "0.21.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pstdio": "./bin/pstdio.cjs",
    "pst": "./bin/pstdio.cjs"
  },
  "files": [
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pufflyai/prompt-studio"
  },
  "scripts": {
    "pstdio": "bun ./src/index.ts",
    "dev": "PSTDIO_DISABLE_EMBED_MANIFEST=1 bun ./src/index.ts -- serve & VITE_API_BASE_URL= bun run --cwd ../pstdio-dashboard dev & wait",
    "build": "bun run --cwd ../../scripts build:host",
    "prepack": "bun run --cwd ../../scripts release:readme -- --package pstdio",
    "postpack": "bun run --cwd ../../scripts release:readme -- --package pstdio --cleanup",
    "local:add": "bun ./scripts/manage-local-pstdio.ts add",
    "local:add-dev": "bun ./scripts/manage-local-pstdio.ts add --dev-server",
    "local:remove": "bun ./scripts/manage-local-pstdio.ts remove",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome lint .",
    "format": "biome format --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@tanstack/react-db": "^0.1.74",
    "mustache": "^4.2.0",
    "react": "^19.2.4",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@pstdio/cli-darwin-arm64": "0.21.0",
    "@pstdio/cli-darwin-x64": "0.21.0",
    "@pstdio/cli-linux-x64": "0.21.0",
    "@pstdio/cli-linux-arm64": "0.21.0",
    "@pstdio/cli-win-x64": "0.21.0",
    "@pstdio/cli-win-arm64": "0.21.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "pstdio-api": "workspace:*",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-dashboard": "workspace:*",
    "pstdio-db": "workspace:*",
    "pstdio-logging": "workspace:*",
    "pstdio-paths": "workspace:*",
    "pstdio-wt": "workspace:*",
    "@pstdio/sdk": "workspace:*",
    "typescript": "6.0.2"
  }
}
