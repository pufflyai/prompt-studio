{
  "name": "pstdio",
  "version": "0.5.0",
  "type": "module",
  "bin": {
    "pstdio": "./bin/pstdio.cjs"
  },
  "files": [
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pufflyai/prompt-studio"
  },
  "scripts": {
    "pstdio": "bun ./src/index.ts",
    "dev": "PSTDIO_DISABLE_EMBED_MANIFEST=1 bun --watch ./src/index.ts -- serve & VITE_API_BASE_URL= bun run --cwd ../pstdio-dashboard dev & wait",
    "build": "bun run ../../scripts/build-compile.ts",
    "prepack": "bun run ../../scripts/sync-package-readme.ts --package pstdio",
    "postpack": "bun run ../../scripts/sync-package-readme.ts --package pstdio --cleanup",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome lint .",
    "format": "biome format --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@tanstack/react-db": "^0.1.74",
    "mustache": "^4.2.0",
    "react": "^19.2.4",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@pstdio/cli-darwin-arm64": "0.5.0",
    "@pstdio/cli-darwin-x64": "0.5.0",
    "@pstdio/cli-linux-x64": "0.5.0",
    "@pstdio/cli-linux-arm64": "0.5.0",
    "@pstdio/cli-linux-x64-musl": "0.5.0",
    "@pstdio/cli-linux-arm64-musl": "0.5.0",
    "@pstdio/cli-win-x64": "0.5.0",
    "@pstdio/cli-win-arm64": "0.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "pstdio-agents": "workspace:*",
    "pstdio-api": "workspace:*",
    "pstdio-dashboard": "workspace:*",
    "pstdio-db": "workspace:*",
    "pstdio-hooks": "workspace:*",
    "pstdio-logging": "workspace:*",
    "pstdio-wt": "workspace:*",
    "typescript": "~5.9.3"
  }
}
