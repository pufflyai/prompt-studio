{
  "name": "workbench-fixture",
  "version": "0.8.3",
  "displayName": "Workbench fixture",
  "description": "Test fixtures for extension and workbench contracts.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.3.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/ci/run-bun-tests.ts",
    "typecheck": "bun check -p ../../tsconfig.test-fixtures.json"
  },
  "nx": {
    "implicitDependencies": [
      "@pstdio/sdk",
      "@pstdio/ui"
    ],
    "targets": {
      "typecheck": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tsconfig.test-fixtures.json"
        ]
      }
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.0.0",
    "@pstdio/sdk": "0.46.0-preview.sha-2c2b2e4c6b144c418cc048219c56553afe938bf4",
    "@pstdio/ui": "0.46.0-preview.sha-2c2b2e4c6b144c418cc048219c56553afe938bf4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.2"
  }
}
