{
  "name": "pstdio-extensions",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "src/bridge/runtime.html"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./runtime-ui": "./src/runtime-ui/index.ts",
    "./bridge/contract": "./src/bridge/contract/index.ts",
    "./bridge/host": "./src/bridge/host/index.ts",
    "./bridge/guest": "./src/bridge/guest/index.ts",
    "./bridge/guest/bootstrap": "./src/bridge/guest/bootstrap.ts",
    "./bridge/runtime.html": "./src/bridge/runtime.html"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@pstdio/sdk": "workspace:*",
    "rimless": "^0.7.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "6.0.2"
  }
}
