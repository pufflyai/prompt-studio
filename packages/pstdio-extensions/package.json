{
  "name": "pstdio-extensions",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/src/bridge/webview-runtime/runtime.bundle.js"
        ]
      }
    }
  },
  "main": "./src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./bridge/contract": "./src/bridge/contract/index.ts",
    "./bridge/guest": "./src/bridge/guest/index.ts",
    "./bridge/host": "./src/bridge/host/index.ts",
    "./bridge/webview-runtime": "./src/bridge/webview-runtime/index.ts",
    "./bridge/webview-runtime-html": "./src/bridge/webview-runtime/runtime-html.ts",
    "./bridge/webview-runtime.bundle.js": "./src/bridge/webview-runtime/runtime.bundle.js",
    "./workbench": "./src/workbench/index.ts",
    "./bridge/diagnostics": "./src/bridge/host/host-diagnostics.ts",
    "./authoring": "./src/authoring/index.ts",
    "./distribution": "./src/distribution/index.ts"
  },
  "scripts": {
    "build": "bun run build:runtime",
    "build:runtime": "bun run scripts/build-runtime.ts",
    "typecheck": "bun check",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun ../../scripts/ci/run-bun-tests.ts --conditions=source --silent",
    "test:coverage": "bun ../../scripts/ci/run-bun-tests.ts --conditions=source --coverage"
  },
  "dependencies": {
    "@pstdio/sdk": "workspace:*",
    "@tanstack/hotkeys": "^0.7.1",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-paths": "workspace:*",
    "rimless": "0.8.3",
    "tar-stream": "3.2.2",
    "zod": "^4.1.12",
    "pstdio-theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.2.3",
    "extension-lab": "workspace:*",
    "react": "19.2.4",
    "typescript": "6.0.2"
  }
}
