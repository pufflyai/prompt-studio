{
  "name": "pstdio-extensions",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent --max-concurrency=1",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@pstdio/pstdio-ext-harness-claude-code": "workspace:*",
    "@pstdio/pstdio-ext-harness-fake": "workspace:*",
    "@pstdio/pstdio-ext-harness-opencode": "workspace:*",
    "@pstdio/pstdio-ext-planner": "workspace:*",
    "@pstdio/pstdio-ext-workspace-changes": "workspace:*",
    "@pstdio/sdk": "workspace:*",
    "pstdio-db": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "6.0.2"
  }
}
