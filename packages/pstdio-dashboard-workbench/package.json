{
  "name": "pstdio-dashboard-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "bun run typecheck && biome check .",
    "test": "bun test --silent --tsconfig-override tsconfig.app.json",
    "smoke": "bun test src/smoke/dashboard-workbench-smoke.test.ts --silent --tsconfig-override tsconfig.app.json",
    "test:coverage": "bun test --coverage --tsconfig-override tsconfig.app.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/onest": "^5.2.11",
    "@pstdio/sdk": "workspace:*",
    "@pstdio/ui": "workspace:*",
    "@tanstack/react-db": "^0.1.74",
    "@tanstack/react-query": "^5.90.21",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.556.0",
    "pstdio-workbench": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@storybook/addon-themes": "^10.1.10",
    "@storybook/react": "^10.1.9",
    "@storybook/react-vite": "^10.1.9",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "storybook": "^10.1.9",
    "typescript": "6.0.2",
    "vite": "^7.2.4"
  }
}
