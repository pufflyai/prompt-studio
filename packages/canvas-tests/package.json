{
  "name": "canvas-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/ci/run-ci-checks.ts --plan checks.json",
    "test:scripts": "bun ../../scripts/ci/run-bun-tests.ts src/scripts --timeout 30000 --silent",
    "test:browser": "bun src/scripts/run-browser.ts",
    "build:stories": "bun src/scripts/build:preview-testss.ts",
    "typecheck": "bun check",
    "lint": "bun run typecheck && biome check .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@pstdio/ui": "workspace:*",
    "@pstdio/workbench": "workspace:*",
    "pstdio-dashboard": "workspace:*"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "test:browser": {
        "dependsOn": [
          "^build"
        ]
      },
      "build:stories": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{workspaceRoot}/packages/ui/canvas-test-static",
          "{workspaceRoot}/packages/pstdio-dashboard/canvas-test-static",
          "{workspaceRoot}/packages/pstdio-workbench/canvas-test-static"
        ]
      }
    }
  }
}
