{
  "name": "pstdio-api",
  "private": true,
  "exports": {
    "./app": "./src/app.ts",
    "./runtime": "./src/features/runtime/routes.ts"
  },
  "scripts": {
    "start": "bun --conditions=source run src/server.ts",
    "dev": "bun --conditions=source run --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "analyze-bundle": "bun build ./src/index.ts --outdir ./dist --target bun --metafile=./dist/bundle-meta.json --metafile-md=./dist/bundle-meta.md",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "PSTDIO_DEFAULT_EXTENSIONS='[]' PSTDIO_EXTENSION_WEBVIEW_BUILDS='0' bun src/test-utils/run-api-tests.ts",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-api-runtime-host": "workspace:*",
    "pstdio-db": "workspace:*",
    "pstdio-extensions": "workspace:*",
    "pstdio-logging": "workspace:*",
    "pstdio-paths": "workspace:*",
    "pstdio-scheduler": "workspace:*",
    "pstdio-storage": "workspace:*",
    "pstdio-wt": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/bun": "1.4.2",
    "@types/cmd-shim": "5.0.2",
    "cmd-shim": "7.0.0",
    "extension-lab": "workspace:*",
    "pstdio-planner": "workspace:*",
    "pstdio-skills": "workspace:*",
    "typescript": "6.0.2"
  }
}
