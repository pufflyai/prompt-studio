{
  "name": "pstdio-api",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./dto": "./src/dto.ts",
    "./error-log": "./src/lib/error-log.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "analyze-bundle": "bun build ./src/index.ts --outdir ./dist --target bun --metafile=./dist/bundle-meta.json --metafile-md=./dist/bundle-meta.md",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "hono": "^4.10.7",
    "drizzle-orm": "^0.45.1",
    "pstdio-agents": "workspace:*",
    "pstdio-db": "workspace:*",
    "pstdio-storage": "workspace:*",
    "pstdio-wt": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
