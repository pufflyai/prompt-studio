BASE_PATH="/"
NODE_ENV="development"
TODO_STORAGE_PATH=".data/todos"

# Remote mode MinIO storage (required when running src/index.remote.ts)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="todos"
MINIO_PREFIX="workspaces"
MINIO_REGION="us-east-1"

# Remote sync preset (all required to enable "set remote" on workspaces)
REMOTE_API_URL="http://localhost:19840"
REMOTE_PUBLIC_API_URL="http://localhost:3100"
REMOTE_ELECTRIC_URL="http://localhost:3001"
REMOTE_JWT_SECRET="electric-dev-secret"
