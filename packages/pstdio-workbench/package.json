    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.1.10",
    "@storybook/react": "^10.1.9",
    "@storybook/react-vite": "^10.1.9",
    "@types/bun": "latest",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
