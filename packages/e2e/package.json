{
  "name": "e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run test:scripts && bun run test:cli && bun run test:ui && bun run test:vite-terminal",
    "test:cli": "bun ../../scripts/ci/run-bun-tests.ts --preload ./src/scripts/bun-process-cleanup.ts src/cli --timeout 30000 --silent",
    "test:scripts": "bun ../../scripts/ci/run-bun-tests.ts --preload ./src/scripts/bun-process-cleanup.ts src/scripts src/helpers src/local-workspace-registry.p0.test.ts src/default-extensions.p0.test.ts --timeout 30000 --silent",
    "test:packaged": "bun run test:packaged:cli && bun run test:packaged:browser && bun run test:packaged:benchmark",
    "test:packaged:cli": "bun src/packaged/run-packaged-cli-tests.ts",
    "test:packaged:browser": "playwright test --config playwright.packaged.config.ts",
    "prepare:isolated-paged-collections": "bun src/packaged/prepare-isolated-paged-collections.ts",
    "validate:isolated-paged-collections": "bun src/packaged/validate-isolated-paged-collections.ts",
    "test:ui": "bun run src/scripts/run-playwright.ts",
    "test:smoke": "bun run src/scripts/run-playwright.ts --config playwright.smoke.config.ts",
    "test:vite-terminal": "bun run src/scripts/run-vite-terminal-playwright.ts",
    "perf:frontend": "bun run --cwd ../.. build -- --scope e2e --scope pstdio-dashboard --include-dependencies && bun run src/scripts/run-playwright.ts -c playwright.perf.config.ts",
    "perf:frontend:trace": "PLAYWRIGHT_TRACE=on bun run perf:frontend",
    "test:planner-stress": "bun src/perf/planner-stress.diagnostic.ts",
    "perf:subnav": "bun src/perf/subnav.p3.bench.ts",
    "report": "playwright show-report",
    "perf:planner-board-cold-open": "bun src/perf/planner-board-cold-open.p3.bench.ts",
    "perf:storage-scale": "bun src/perf/storage-scale.diagnostic.ts",
    "perf:storage-scale:build": "bun build src/perf/storage-scale-extension.ts --target bun --external @pstdio/sdk/extensions --outfile dist/storage-scale/scale.js",
    "perf:timing-window": "bun src/perf/storage-timing-window.ts",
    "test:packaged:benchmark": "playwright test --config playwright.packaged-benchmark.config.ts",
    "bench:planner-stress": "bun src/perf/planner-stress.diagnostic.ts --packaged"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@playwright/test": "^1.60.0",
    "@pstdio/sdk": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@types/cmd-shim": "5.0.2",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "cmd-shim": "7.0.0",
    "extension-lab": "workspace:*",
    "harness-claude-code": "workspace:*",
    "harness-codex": "workspace:*",
    "harness-open-code": "workspace:*",
    "harness-pi": "workspace:*",
    "jose": "^6.2.12",
    "local-example": "workspace:*",
    "pg": "^8.20.0",
    "pstdio": "workspace:*",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-artifacts": "workspace:*",
    "pstdio-base-themes": "workspace:*",
    "pstdio-benchmarks": "workspace:*",
    "pstdio-dashboard": "workspace:*",
    "pstdio-db": "workspace:*",
    "pstdio-diagnostics": "workspace:*",
    "pstdio-extensions": "workspace:*",
    "pstdio-notes": "workspace:*",
    "pstdio-planner": "workspace:*",
    "pstdio-reports": "workspace:*",
    "pstdio-scripts": "workspace:*",
    "pstdio-skills": "workspace:*",
    "pstdio-sync": "workspace:*",
    "pstdio-sync-contracts": "workspace:*",
    "pstdio-wt": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remote-workspaces": "workspace:*",
    "storage-scale-fixture": "workspace:*",
    "workbench-fixture": "workspace:*"
  }
}
