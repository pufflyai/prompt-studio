{
  "name": "e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run test:scripts && bun run test:cli && bun run test:ui && bun run test:vite-terminal",
    "test:cli": "bun test src/cli --timeout 30000 --silent",
    "test:scripts": "bun test src/scripts src/helpers src/local-workspace-registry.test.ts src/default-extensions.test.ts --timeout 30000 --silent",
    "test:packaged": "bun run test:packaged:cli && bun run test:packaged:browser",
    "test:packaged:cli": "bun test src/packaged --timeout 30000 --silent --path-ignore-patterns='**/*.spec.ts'",
    "test:packaged:browser": "playwright test --config playwright.packaged.config.ts",
    "test:ui": "bun run src/scripts/run-playwright.ts",
    "test:vite-terminal": "bun run src/scripts/run-vite-terminal-playwright.ts",
    "perf:frontend": "bunx playwright test -c playwright.perf.config.ts",
    "perf:frontend:trace": "PLAYWRIGHT_TRACE=on bunx playwright test -c playwright.perf.config.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "extension-lab": "workspace:*",
    "harness-claude-code": "workspace:*",
    "harness-codex": "workspace:*",
    "harness-open-code": "workspace:*",
    "pstdio": "workspace:*",
    "pstdio-api-contracts": "workspace:*",
    "pstdio-artifacts": "workspace:*",
    "pstdio-base-themes": "workspace:*",
    "pstdio-extensions": "workspace:*",
    "pstdio-notes": "workspace:*",
    "pstdio-planner": "workspace:*",
    "pstdio-reports": "workspace:*",
    "pstdio-skills": "workspace:*",
    "pstdio-wt": "workspace:*",
    "workbench-fixture": "workspace:*"
  }
}
