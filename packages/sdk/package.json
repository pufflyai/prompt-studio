{
  "name": "@pstdio/sdk",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/pufflyai/prompt-studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && bun run build:js && bun run build:types",
    "build:js": "bun build ./src/api/index.ts ./src/client/index.ts ./src/extensions/index.ts ./src/plugins/index.ts ./src/prompts/index.ts ./src/hooks/index.ts ./src/resources/index.ts --outdir ./dist --root ./src --target node --format esm --packages external",
    "build:types": "tsc --project ./tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "bun test --silent",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mustache": "^4.2.6",
    "pstdio-api-contracts": "workspace:*",
    "typescript": "6.0.2"
  }
}
