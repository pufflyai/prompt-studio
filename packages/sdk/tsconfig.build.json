{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "..",
    // Keeps union and inferred property order fixed, so the API report changes only when the API does.
    "stableTypeOrdering": true,
    "paths": {
      "@/*": ["./src/*"],
      "pstdio-api-contracts": ["../pstdio-api-contracts/src/index.ts"],
      "pstdio-api-contracts/*": ["../pstdio-api-contracts/src/*"]
    }
  },
  "include": ["src", "../pstdio-api-contracts/src"],
  "exclude": ["**/*.test.ts", "**/*.typecheck.ts", "../pstdio-api-contracts/src/**/*.test.ts"]
}
