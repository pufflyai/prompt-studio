{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "..",
    // Keeps union and inferred property order fixed, so the API report changes only when the API does.
    "stableTypeOrdering": true,
    "paths": {
      "@/*": ["./src/*"],
      "pstdio-api-contracts": ["../pstdio-api-contracts/src/index.ts"],
      "pstdio-api-contracts/*": ["../pstdio-api-contracts/src/*"],
      "pstdio-sync-contracts": ["../pstdio-sync-contracts/src/index.ts"]
    }
  },
  "include": ["src", "../pstdio-api-contracts/src", "../pstdio-sync-contracts/src/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.typecheck.ts",
    "../pstdio-api-contracts/src/**/*.test.ts",
    "../pstdio-sync-contracts/src/**/*.test.ts"
  ]
}
