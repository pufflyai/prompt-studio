{
  "name": "pstdio-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "bun run typegen:tokens",
    "typecheck": "bun run typegen:tokens && tsc -b",
    "lint": "bun run typecheck && biome check .",
    "test": "bun test --silent --tsconfig-override tsconfig.app.json",
    "test:coverage": "bun test --coverage --tsconfig-override tsconfig.app.json",
    "preview": "vite preview",
    "typegen:tokens": "chakra typegen ../ui/src/theme/theme.ts",
    "visualize-bundle": "bunx vite-bundle-visualizer",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.32.0",
    "@chakra-ui/react": "3.32.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "11.14.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/onest": "^5.2.11",
    "@fontsource/playfair-display": "^5.2.8",
    "@lexical/code": "^0.36.2",
    "@lexical/link": "^0.36.2",
    "@lexical/list": "^0.36.2",
    "@lexical/mark": "^0.36.2",
    "@lexical/markdown": "^0.36.2",
    "@lexical/react": "^0.36.2",
    "@lexical/rich-text": "^0.36.2",
    "@lexical/selection": "^0.36.2",
    "@lexical/table": "^0.36.2",
    "@lexical/utils": "^0.36.2",
    "@monaco-editor/react": "^4.7.0",
    "@pstdio/prompt-utils": "0.1.4",
    "@pstdio/ui": "workspace:*",
    "@storybook/addon-themes": "^10.1.10",
    "@tanstack/hotkeys": "^0.7.1",
    "@tanstack/react-db": "^0.1.74",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.140.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.15.18",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "immer": "^11.1.3",
    "katex": "^0.16.11",
    "lexical": "^0.36.2",
    "lucide-react": "^0.556.0",
    "prismjs": "^1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^16.5.4",
    "recharts": "^3.7.0",
    "use-stick-to-bottom": "^1.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "pstdio-api": "workspace:*",
    "@storybook/react": "^10.1.9",
    "@storybook/react-vite": "^10.1.9",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "storybook": "^10.1.9",
    "typescript": "6.0.2",
    "vite": "^7.2.4"
  }
