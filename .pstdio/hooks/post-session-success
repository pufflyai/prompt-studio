#!/bin/sh

# ──────────────────────────────────────────────────────────
# pstdio post-session-success hook
# Runs after an attempt session completes successfully.
#
# Checks if the attempt is marked "review-ready" and triggers
# downstream review workflows when it is.
# ──────────────────────────────────────────────────────────

PAYLOAD=$(cat)

ATTEMPT_STATUS=$(printf '%s\n' "$PAYLOAD" | jq -r '.attempt.status // empty')
TICKET_ID=$(printf '%s\n' "$PAYLOAD" | jq -r '.ticket.id // empty')

# ──────────────────────────────────────────────────────────
# Blocked — move the ticket to "blocked" status.
# ──────────────────────────────────────────────────────────

if [ "$ATTEMPT_STATUS" = "blocked" ] && [ -n "$TICKET_ID" ]; then
  pstdio tickets update --id "$TICKET_ID" --status "blocked"
  exit 0
fi

if [ "$ATTEMPT_STATUS" != "review-ready" ]; then
  exit 0
fi

# ──────────────────────────────────────────────────────────
# Attempt is review-ready — validate and move ticket.
# ──────────────────────────────────────────────────────────

VALIDATE_OUTPUT=$(bun run validate 2>&1)

if [ $? -ne 0 ]; then
  if [ -n "$PSTDIO_WORKSPACE" ]; then
    pstdio workspaces set-status --workspace "$PSTDIO_WORKSPACE" --status wip
  fi

  SESSION_ID=$(printf '%s\n' "$PAYLOAD" | jq -r '.session.id // empty')
  if [ -n "$SESSION_ID" ]; then
    pstdio sessions follow-up --id "$SESSION_ID" \
      --prompt "Validation failed. Fix the errors and mark the attempt review-ready again:

$VALIDATE_OUTPUT"
  fi
  exit 0
fi

# If no attempt is still WIP, move the ticket to review.
WIP_COUNT=$(printf '%s\n' "$PAYLOAD" | jq '[.ticket.attempts[] | select(.status == "running")] | length')

if [ "$WIP_COUNT" -eq 0 ]; then
  pstdio tickets update --id "$TICKET_ID" --status "review"
fi
