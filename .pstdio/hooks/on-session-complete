#!/bin/sh

# ──────────────────────────────────────────────────────────
# pstdio on-session-complete hook
# Runs after an agent session reaches a terminal status.
#
# - On success: commits changes and moves ticket to review
# - On failure: moves ticket back to wip
# ──────────────────────────────────────────────────────────

# Nothing to validate without a workspace
[ -z "$PSTDIO_WORKSPACE" ] && exit 0
[ -z "$PSTDIO_TICKET_SHORTHAND" ] && exit 0

cd "$PSTDIO_WORKTREE_PATH" || exit 1

output=$(bun run validate 2>&1)

if [ $? -eq 0 ]; then
  git add -A
  git commit -m "checkpoint: $PSTDIO_TICKET_SHORTHAND session complete"
  pstdio tickets update --id "$PSTDIO_TICKET_SHORTHAND" --status "review"
else
  pstdio tickets update --id "$PSTDIO_TICKET_SHORTHAND" --status "wip"
  pstdio sessions follow-up --id "$PSTDIO_SESSION_ID" \
    --prompt "Validation failed. Fix the issues and try again:\n$output"
fi
