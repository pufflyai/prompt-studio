#!/bin/sh
set -eu

# ──────────────────────────────────────────────────────────
# Post-hook: runs after a review session ends with changes-requested
# Follows up the original session with the review summary.
# ──────────────────────────────────────────────────────────

run_pstdio workspaces set-status \
  --workspace "$PSTDIO_WORKSPACE" \
  --status "wip"

run_pstdio sessions follow-up \
  --id "$PSTDIO_ORIGINAL_SESSION_ID" \
  --template "fix-changes-requested" \
  --var "ticket=$PSTDIO_TICKET"

