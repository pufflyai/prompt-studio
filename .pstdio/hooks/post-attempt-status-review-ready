#!/bin/sh
set -eu

# ──────────────────────────────────────────────────────────
# Post-hook: create a review session after review-ready
# Fires after the originating session completes.
# ──────────────────────────────────────────────────────────

TICKET_LABEL="${PSTDIO_TICKET:-ticket}"

REVIEW_PROMPT=$(cat <<EOF
Review the changes in this worktree. Focus on correctness, regressions, and missing tests. Summarize findings with file references.

Ensure a changeset is present.

Write the review to .pstdio/tickets/$PSTDIO_TICKET/review.md in the ticket folder.
EOF
)

pstdio sessions create \
  --workspace-id "$PSTDIO_WORKSPACE_ID" \
  --title "Code review: $TICKET_LABEL" \
  --prompt "$REVIEW_PROMPT" \
