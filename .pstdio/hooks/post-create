#!/bin/sh

# ──────────────────────────────────────────────────────────
# pstdio post-create hook
# Runs after a new worktree is created for a workspace.
#
# DO NOT REMOVE this block — it ensures the worktree has
# the project config and ticket context needed for agents.
# ──────────────────────────────────────────────────────────

# Copy .pstdio/config.json so the worktree is recognized as a pstdio project
if [ -f "$PSTDIO_REPO_PATH/.pstdio/config.json" ]; then
  mkdir -p "$PSTDIO_WORKTREE_PATH/.pstdio"
  cp "$PSTDIO_REPO_PATH/.pstdio/config.json" "$PSTDIO_WORKTREE_PATH/.pstdio/config.json"
fi

# Copy agent folders so workspace-local skills are available in the worktree
for AGENT_DIR in ".claude" ".opencode"; do
  if [ -d "$PSTDIO_REPO_PATH/$AGENT_DIR" ]; then
    mkdir -p "$PSTDIO_WORKTREE_PATH/$AGENT_DIR"
    cp -R "$PSTDIO_REPO_PATH/$AGENT_DIR/." "$PSTDIO_WORKTREE_PATH/$AGENT_DIR/"
  fi
done

# Pull the ticket into the worktree so agents have full context
# Workspace shorthand is <ticket>_A<n>, extract ticket shorthand
TICKET_SHORTHAND=$(printf '%s\n' "$PSTDIO_WORKSPACE" | sed 's/_A[0-9]*$//')
if [ -n "$TICKET_SHORTHAND" ]; then
  pstdio tickets pull --id "$TICKET_SHORTHAND" 2>/dev/null || true
fi

# ──────────────────────────────────────────────────────────
# Add additional setup steps below.
# ──────────────────────────────────────────────────────────

# Copy .env so the worktree uses the same dev database paths
if [ -f "$PSTDIO_REPO_PATH/.env" ]; then
  cp "$PSTDIO_REPO_PATH/.env" "$PSTDIO_WORKTREE_PATH/.env"
fi

bun install
bun run build
