#!/bin/sh
set -eu

# ──────────────────────────────────────────────────────────
# Pre-hook: validate before allowing transition to review-ready
# Runs bun run validate; rejects transition on failure.
# ──────────────────────────────────────────────────────────

cd "${PSTDIO_WORKTREE_PATH:-$(pwd)}"
exec bun run validate
