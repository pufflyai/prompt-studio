{
  "$schema": "https://unpkg.com/@changesets/config@3.1.3/schema.json",
  "changelog": "./changelog.cjs",
  "commit": false,
  "fixed": [["pstdio", "@pstdio/sdk", "@pstdio/ui", "@pstdio/workbench", "@pstdio/desktop"]],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "bumpVersionsWithWorkspaceProtocolOnly": true,
  "ignore": [
    "@pstdio/landing-page",
    "bookmarks",
    "e2e",
    "font-editor",
    "local-example",
    "pstdio-api",
    "pstdio-api-contracts",
    "pstdio-api-runtime-host",
    "pstdio-benchmarks",
    "pstdio-dashboard",
    "pstdio-diagnostics",
    "pstdio-db",
    "pstdio-extension-testbench",
    "pstdio-extensions",
    "pstdio-file-types",
    "pstdio-logging",
    "pstdio-paths",
    "pstdio-dev",
    "pstdio-scheduler",
    "pstdio-scripts",
    "pstdio-storage",
    "pstdio-sync",
    "pstdio-sync-contracts",
    "pstdio-wt",
    "workbench-fixture",
    "motion-lab",
    "social-radar",
    "pstdio-shader-lab",
    "shape-art",
    "pstdio-relay",
    "pstdio-account-manager",
    "relay-demo",
    "pstdio-service-telemetry",
    "pstdio-psx",
    "storage-scale-fixture",
    "storybook-tests"
  ],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}.{datetime}"
  },
  "privatePackages": {
    "version": true,
    "tag": false
  }
}
