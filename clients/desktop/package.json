{
  "name": "@pstdio/desktop",
  "productName": "Prompt Studio",
  "version": "0.25.2",
  "private": true,
  "description": "The local-first Prompt Studio desktop application.",
  "author": "Prompt Studio <support@prompt.studio>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run build:main && bun run build:preload && vite build",
    "build:main": "bun build src/main.ts --outfile dist/main.js --target node --format esm --external electron",
    "build:preload": "bun build src/preload.ts --outfile dist/preload.cjs --target node --format cjs --external electron",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "lint": "tsc --noEmit && biome check .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "start": "electron dist/main.js",
    "test": "bun test src --silent --path-ignore-patterns='**/e2e/**'",
    "test:electron": "bun run build && playwright test --config playwright.config.ts",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "verify:fuses": "bun scripts/verify-fuses.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@pstdio/ui": "workspace:*",
    "electron-squirrel-startup": "1.0.1",
    "pstdio": "workspace:*",
    "pstdio-logging": "workspace:*",
    "pstdio-paths": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2",
    "@playwright/test": "1.60.0",
    "@types/bun": "1.3.13",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.3.0",
    "typescript": "6.0.2",
    "vite": "7.3.5"
  }
}
