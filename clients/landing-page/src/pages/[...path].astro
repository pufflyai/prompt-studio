---
import { IndexPage } from "../components/index-page";
import BaseLayout from "../layouts/base-layout.astro";
import { ALL_LANDING_PATHS } from "../services/landing-route";
import { loadLegalDocuments } from "../services/legal-documents";

export const getStaticPaths = () =>
  ALL_LANDING_PATHS.filter((path) => path !== "/").map((path) => ({ params: { path: path.slice(1, -1) } }));

const legalDocuments = await loadLegalDocuments();
---

<BaseLayout>
  <IndexPage initialPath={Astro.url.pathname} legalDocuments={legalDocuments} client:load />
</BaseLayout>
