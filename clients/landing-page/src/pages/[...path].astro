---
import { IndexPage } from "../components/index-page";
import BaseLayout from "../layouts/base-layout.astro";
import { landingPageFromPath, servedPaths } from "../services/landing-route";
import { loadSiteCatalog } from "../services/site-catalog";

export const getStaticPaths = async () => {
  const { pages } = await loadSiteCatalog();
  return servedPaths(pages).map((path) => ({ params: { path: path === "/" ? undefined : path.slice(1, -1) } }));
};

// Each page carries its own document HTML and the catalog of titles and paths.
// Other documents load on navigation from `/documents/<path>.json`.
const { pages, documents } = await loadSiteCatalog();
const page = landingPageFromPath(pages, Astro.url.pathname)!;
---

<BaseLayout page={page}>
  <IndexPage initialPath={Astro.url.pathname} pages={pages} initialDocument={documents.get(page.path)} client:load />
</BaseLayout>
