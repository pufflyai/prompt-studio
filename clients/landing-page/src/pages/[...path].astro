---
import { IndexPage } from "../components/index-page";
import { ALL_LANDING_PATHS } from "../components/landing/landing-route";
import { ALL_REPOSITORY_DOC_PATHS } from "../components/landing/repository-docs";
import BaseLayout from "../layouts/base-layout.astro";

export const getStaticPaths = () =>
  [...new Set([...ALL_LANDING_PATHS, ...ALL_REPOSITORY_DOC_PATHS])]
    .filter((path) => path !== "/")
    .map((path) => ({ params: { path: path.slice(1) } }));
---

<BaseLayout>
  <IndexPage initialPath={Astro.url.pathname} client:load />
</BaseLayout>

<script>
  const stored = localStorage.getItem("theme-preference");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  const dark = stored ? stored.includes("dark") : prefersDark;
  document.documentElement.classList.toggle("dark", dark);
  document.documentElement.classList.toggle("light", !dark);
</script>
