---
import { BlogPostShell } from "../components/blog/blog-post-header";
import BaseLayout from "./base-layout.astro";

const { frontmatter, rawContent } = Astro.props;
const title = frontmatter?.title ?? "";
const description = frontmatter?.description ?? "";
const released = frontmatter?.released ?? "";
const category = frontmatter?.category ?? "Blog";
const author = frontmatter?.author ?? { name: "Unknown", role: "" };
const markdown = typeof rawContent === "function" ? rawContent() : "";
const readingTimeMinutes = getReadingTimeMinutes(markdown);

function getReadingTimeMinutes(markdown: string) {
  const words = markdown.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 225));
}
---

<BaseLayout title={`${title} | Prompt Studio`} description={description}>
  <BlogPostShell
    client:load
    title={title}
    released={released}
    category={category}
    author={author}
    readingTimeMinutes={readingTimeMinutes}
  >
    <div class="markdown">
      <slot />
    </div>
  </BlogPostShell>
</BaseLayout>
