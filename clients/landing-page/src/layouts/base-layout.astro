---
import { siteMetadata } from "../config/site-metadata";
import { landingMetadata } from "../services/landing-metadata";

const { title, description, canonicalUrl, structuredData, indexable } = landingMetadata(Astro.url.pathname);
const { banner, themeColor } = siteMetadata;
const bannerUrl = new URL(banner.path, siteMetadata.siteUrl).href;
const faviconSvgUrl = new URL(siteMetadata.faviconSvgPath, siteMetadata.siteUrl).href;
const faviconPngUrl = new URL(siteMetadata.faviconPngPath, siteMetadata.siteUrl).href;
const appleTouchIconUrl = new URL(siteMetadata.appleTouchIconPath, siteMetadata.siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}

    {indexable && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prompt Studio" />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />
    <meta property="og:image:width" content={String(banner.width)} />
    <meta property="og:image:height" content={String(banner.height)} />
    <meta property="og:image:alt" content={banner.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />
    <meta name="twitter:image:alt" content={banner.alt} />

    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link rel="icon" type="image/png" href={faviconPngUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />

    {indexable && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script src="../services/analytics.ts"></script>
    <script>
      const stored = localStorage.getItem("theme-preference");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const dark = stored ? stored.includes("dark") : prefersDark;
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("light", !dark);
    </script>
  </head>
  <body style="margin:0;overflow:auto;">
    <slot />
  </body>
</html>
