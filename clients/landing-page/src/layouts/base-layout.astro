---
import "@pstdio/ui/style.css";
import { siteMetadata } from "../config/site-metadata";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteMetadata.title, description = siteMetadata.description } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteMetadata.siteUrl).href;
const bannerUrl = new URL(siteMetadata.bannerPath, siteMetadata.siteUrl).href;
const faviconSvgUrl = new URL(siteMetadata.faviconSvgPath, siteMetadata.siteUrl).href;
const faviconPngUrl = new URL(siteMetadata.faviconPngPath, siteMetadata.siteUrl).href;
const keywords = siteMetadata.keywords.join(", ");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Prompt Studio",
  url: canonicalUrl,
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  image: bannerUrl,
};

const themeBootstrapScript = `
(() => {
  const storageKey = "theme-preference";
  const root = document.documentElement;
  const stored = window.localStorage.getItem(storageKey);
  const prefersDark =
    typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: dark)").matches;
  let theme = prefersDark ? "dark" : "light";

  if (stored === "dark" || stored === "light") {
    theme = stored;
  }

  const opposite = theme === "dark" ? "light" : "dark";

  root.classList.remove(opposite);
  root.classList.add(theme);
  root.setAttribute("data-theme", theme);
  root.style.colorScheme = theme;
})();
`;

const themeCriticalStyles = `
.theme-toggle__icon {
  align-items: center;
  display: inline-flex;
  height: 18px;
  justify-content: center;
  line-height: 0;
  width: 18px;
}

.theme-toggle__icon--sun {
  display: none;
}

html.dark .theme-toggle__icon--moon,
html[data-theme="dark"] .theme-toggle__icon--moon {
  display: none;
}

html.dark .theme-toggle__icon--sun,
html[data-theme="dark"] .theme-toggle__icon--sun {
  display: inline-flex;
}
`;
---

<!doctype html>
<html lang="en" style="height:auto;min-height:100%;overflow:auto;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    <script is:inline set:html={themeBootstrapScript} />
    <style is:inline set:html={themeCriticalStyles} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="image" content={bannerUrl} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link rel="icon" type="image/png" href={faviconPngUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style="margin:0;height:auto;min-height:100%;overflow:visible;">
    <slot />
  </body>
</html>
