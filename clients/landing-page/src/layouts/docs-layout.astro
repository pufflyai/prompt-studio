---
import {
  buildDocsMenuItems,
  docsOverviewEntry,
  getDocsPagination,
  normalizeDocsPath,
  sortDocs,
} from "../components/docs/docs-menu";
import type { DocsPageMeta } from "../components/docs/docs-page-shell";
import { DocsPageShell } from "../components/docs/docs-page-shell";
import { buildDocsSearchItems, extractDocsOutlineItems } from "../components/docs/docs-search";
import BaseLayout from "./base-layout.astro";

interface DocsModule {
  frontmatter: DocsPageMeta;
  url: string;
  rawContent?: () => string;
}

const { frontmatter, rawContent } = Astro.props;
const title = frontmatter?.title ?? "";
const description = frontmatter?.description ?? "";
const htmlTitle = frontmatter?.htmlTitle ?? title;
const htmlDescription = frontmatter?.htmlDescription ?? description;
const badge = frontmatter?.category ?? frontmatter?.section ?? "Docs";

const markdown = typeof rawContent === "function" ? rawContent() : "";

const docModules = import.meta.glob<DocsModule>("../pages/docs/**/*.md", { eager: true });

const allDocs = sortDocs([
  docsOverviewEntry,
  ...Object.values(docModules).map((mod) => ({
    title: mod.frontmatter.title,
    description: mod.frontmatter.description,
    section: mod.frontmatter.section,
    category: mod.frontmatter.category,
    categoryOrder: mod.frontmatter.categoryOrder,
    order: mod.frontmatter.order,
    url: mod.url!,
    outline: extractDocsOutlineItems(typeof mod.rawContent === "function" ? mod.rawContent() : "", mod.url!),
  })),
]);

const menuItems = buildDocsMenuItems(allDocs);
const searchItems = buildDocsSearchItems(allDocs);

// Build pagination
const currentUrl = normalizeDocsPath(Astro.url.pathname);
const { previous, next } = getDocsPagination(allDocs, currentUrl);
const activeLink = currentUrl;
---

<BaseLayout title={`${htmlTitle} | Docs | Prompt Studio`} description={htmlDescription}>
  <DocsPageShell
    client:load
    title={title}
    description={description}
    badge={badge}
    markdown={markdown}
    menuItems={menuItems}
    searchItems={searchItems}
    activeLink={activeLink}
    previous={previous}
    next={next}
  >
    <div class="markdown">
      <slot />
    </div>
  </DocsPageShell>
</BaseLayout>
