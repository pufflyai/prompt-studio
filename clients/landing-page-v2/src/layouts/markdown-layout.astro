---
import { MarkdownFooter } from "../components/markdown-footer";
import { MarkdownHeader } from "../components/markdown-header";
import BaseLayout from "./base-layout.astro";

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "";
---

<BaseLayout title={title}>
  <div class="markdown-shell">
    <MarkdownHeader client:load />
    <main class="markdown-main">
      <div class="markdown-content">
        <slot />
      </div>
    </main>
    <MarkdownFooter client:load />
  </div>
</BaseLayout>

<style>
  .markdown-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .markdown-main {
    flex: 1;
    max-width: 48rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 7rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .markdown-main {
      padding-top: 7rem;
    }
  }

  .markdown-content :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .markdown-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .markdown-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .markdown-content :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .markdown-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .markdown-content :global(a) {
    text-decoration: underline;
  }

  .markdown-content :global(em) {
    font-style: italic;
  }

  .markdown-content :global(strong) {
    font-weight: 600;
  }
</style>
