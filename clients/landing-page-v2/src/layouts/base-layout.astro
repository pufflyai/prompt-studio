---
import { siteMetadata } from "../config/site-metadata";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteMetadata.title, description = siteMetadata.description } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteMetadata.siteUrl).href;
const bannerUrl = new URL(siteMetadata.bannerPath, siteMetadata.siteUrl).href;
const faviconSvgUrl = new URL(siteMetadata.faviconSvgPath, siteMetadata.siteUrl).href;
const faviconPngUrl = new URL(siteMetadata.faviconPngPath, siteMetadata.siteUrl).href;
const keywords = siteMetadata.keywords.join(", ");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Prompt Studio",
  url: canonicalUrl,
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  image: bannerUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="image" content={bannerUrl} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link rel="icon" type="image/png" href={faviconPngUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style="margin:0;overflow:auto;">
    <slot />
  </body>
</html>
