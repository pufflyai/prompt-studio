{
  "title": "Chat turn",
  "description": "Follow a new message without moving the composer or replaying the history. Every style shows a small spinner and the elapsed time. Compare it alone, with messages rising 4px, or with a glint on the composer edge. Activity sits beside the workspace name; when the turn completes, \"Worked for 8s\" stays there.",
  "duration": 12,
  "markers": [
    {
      "at": 1,
      "label": "Send"
    },
    {
      "at": 1.3,
      "label": "Wait"
    },
    {
      "at": 3,
      "label": "First response"
    },
    {
      "at": 5,
      "label": "Stream"
    },
    {
      "at": 9,
      "label": "Complete"
    }
  ],
  "group": "Chat",
  "canvas": "pane",
  "params": [
    {
      "id": "turn",
      "name": "Turn style",
      "type": "selection",
      "options": [
        {
          "id": "spinner",
          "name": "Spinner"
        },
        {
          "id": "rise",
          "name": "Spinner and rise"
        },
        {
          "id": "edge",
          "name": "Spinner and composer edge"
        }
      ],
      "default": {
        "left": "spinner",
        "right": "edge"
      }
    }
  ]
}
