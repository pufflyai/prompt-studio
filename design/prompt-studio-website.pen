          "children": [
            {
              "type": "frame",
              "id": "U7jat3",
              "name": "aurora.frag editor",
              "width": "fill_container",
              "cornerRadius": 8,
              "stroke": "$ds-border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 16,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "RLSUI",
                  "name": "Filename",
                  "fill": "$ds-fg",
                  "content": "aurora.frag",
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "500"
                },
                {
                  "id": "bPyKR",
                  "type": "ref",
                  "ref": "QiLd0",
                  "name": "aurora.frag ScrollArea",
                  "width": "fill_container",
                  "height": 256,
                  "descendants": {
                    "l1BRHT": {
                      "content": "vec3 shade(vec2 uv) {\n  vec2 p = (uv - 0.5) * u_scale * 0.35;\n  float time = u_time * 0.4;\n  p += 0.18 * sin(p.yx * 1.7 + vec2(time, -time));\n  vec3 color = vec3(0.012, 0.018, 0.04);\n\n  for (int i = 0; i < 6; i++) {\n    float layer = float(i);\n    float wave = sin(p.x * 1.6 + time + layer * 0.7) * 0.4;\n    wave += sin(p.x * 2.8 - time * 0.8 + layer) * 0.16;\n    float ribbon = p.y - wave + (layer - 2.5) * 0.24;\n    float glow = 0.018 / (abs(ribbon) + 0.025);\n    vec3 tint = 0.5 + 0.5 * cos(\n      vec3(0.2, 2.1, 4.3) + layer * 0.75 + p.x * 0.45 + time * 0.3\n    );\n    color += tint * glow * 0.55;\n  }\n  return 1.0 - exp(-color * 1.4);\n}"
                    },
                    "Mznct": {
                      "x": 278
                    },
                    "j9NV7": {
                      "x": 279
                    },
                    "r1PeA": {
                      "width": 272
                    },
                    "eJjbB": {
                      "width": 142
                    }
                  }
                },
                {
                  "type": "text",
                  "id": "GqaY6",
                  "name": "Reset code",
                  "fill": "$ds-fg-subtle",
                  "content": "Reset code",
                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "yWcBL",
              "name": "icon-matrix.frag editor",
              "width": "fill_container",
              "cornerRadius": 8,
              "stroke": "$ds-border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 16,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "sZveM",
                  "name": "Filename",
                  "fill": "$ds-fg",
                  "content": "icon-matrix.frag",
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "500"
                },
                {
                  "id": "csXtr",
                  "type": "ref",
                  "ref": "QiLd0",
                  "name": "icon-matrix.frag ScrollArea",
                  "width": "fill_container",
                  "height": 256,
                  "descendants": {
                    "l1BRHT": {
                      "content": "vec3 shade(vec2 uv) {\n  vec2 cell = uv * u_scale;\n  float column = floor(cell.x);\n  float seed = fract(sin(column * 13.13) * 17.17);\n  float row = floor(cell.y);\n  float phase = mod(row + u_time * mix(1.2, 3.2, seed) + seed * 18.0, 18.0);\n  float trail = exp(-phase * 0.32) * smoothstep(0.0, 0.8, phase);\n  float headDistance = (phase - 1.0) * 1.5;\n  float head = exp(-headDistance * headDistance);\n  float icon = texture2D(u_icon, cell).a;\n\n  vec3 green = vec3(0.04, 0.65, 0.28);\n  vec3 mint = vec3(0.76, 1.0, 0.86);\n  vec3 ink = mix(green, mint, head);\n  return vec3(0.018, 0.04, 0.027)\n    + ink * icon * (0.035 + trail);\n}"
                    },
                    "Mznct": {
                      "x": 278
                    },
                    "j9NV7": {
                      "x": 279
                    },
                    "r1PeA": {
                      "width": 272
                    },
                    "eJjbB": {
                      "width": 142
                    }
