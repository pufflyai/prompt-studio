                                      "content": "Aurélien Franky",
                                      "lineHeight": 1.5,
                                      "fontFamily": "$font-label",
                                      "fontSize": 12,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "OCnrR",
                                  "name": "Publication date and reading time",
                                  "fill": "$ds-fg-muted",
                                  "content": "August 31, 2026 · 3 min read",
                                  "lineHeight": 1.5,
                                  "fontFamily": "$font-label",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "Cyn5U",
                          "name": "p",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A while ago, I found myself with less time to write code. I had to get more done with fewer hours at the keyboard, so I leaned on coding agents. They helped, up to a point.",
                          "lineHeight": 1.71,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "EJgOT",
                          "name": "p",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Once I ran a few of them at the same time, the work got hard to follow. One agent drifted from what I asked. Another one finished, and I did not notice for an hour. Reviewing everything they produced became a job of its own.",
                          "lineHeight": 1.71,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "G7ow5",
                          "name": "h2",
                          "width": "fill_container",
                          "padding": [
                            16,
                            0,
                            0,
                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "Lpcn4",
                              "name": "Heading",
                              "fill": "$ds-fg",
                              "textGrowth": "fixed-width",
