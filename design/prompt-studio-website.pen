        {
          "type": "frame",
          "id": "TwCXd",
          "name": "cmp/Tab",
          "context": "Composable tab: icon/status, label, optional accessory, optional close action, and an optional tab-owned context menu. Secondary/right click opens the registered context menu anchored below that tab; tabs without one keep the default browser/workbench behavior.",
