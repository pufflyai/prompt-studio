                      "name": "T",
                      "fill": "$ds-fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Summarize the remaining risks for this release and flag anything blocking.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "rarIR",
