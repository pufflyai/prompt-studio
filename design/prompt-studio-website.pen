                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 16,
                      "padding": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "vV3n9",
                          "name": "Fragment code scroll area",
                          "context": "Shared ScrollArea: 256 px viewport, vertical and horizontal scrolling. The code keeps full lines without wrapping. Scrollbars appear on hover or scroll.",
                          "clip": true,
                          "width": "fill_container",
                          "height": 256,
                          "fill": "$ds-bg",
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "rkxZn",
                              "x": 12,
                              "y": 8,
                              "name": "Fragment source",
                              "fill": "$ds-fg",
                              "content": "vec3 shade(vec2 uv) {\n  vec2 p = (uv - 0.5) * u_scale * 0.35;\n  float time = u_time * 0.4;\n  p += 0.18 * sin(p.yx * 1.7 + vec2(time, -time));\n  vec3 color = vec3(0.012, 0.018, 0.04);\n\n  for (int i = 0; i < 6; i++) {\n    float layer = float(i);\n    float wave = sin(p.x * 1.6 + time + layer * 0.7) * 0.4;\n    wave += sin(p.x * 2.8 - time * 0.8 + layer) * 0.16;\n    float ribbon = p.y - wave + (layer - 2.5) * 0.24;\n    float glow = 0.018 / (abs(ribbon) + 0.025);\n    vec3 tint = 0.5 + 0.5 * cos(\n      vec3(0.2, 2.1, 4.3) + layer * 0.75 + p.x * 0.45 + time * 0.3\n    );\n    color += tint * glow * 0.55;\n  }\n  return 1.0 - exp(-color * 1.4);\n}",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
