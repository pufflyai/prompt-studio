              "type": "text",
              "id": "YpVO0",
              "name": "p",
              "fill": "$ds-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Prompt Studio is that place. Agents build tools as extensions, and every extension gets the same shared parts: storage, commands, views, and schedules.",
              "lineHeight": 1.71,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
