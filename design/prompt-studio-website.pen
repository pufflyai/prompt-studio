                              "fontFamily": "$font-heading",
                              "fontSize": 36,
                              "fontWeight": "500"
                            },
                            {
                              "type": "frame",
                              "id": "plqve",
                              "name": "Post metadata",
                              "context": "Author avatar and name, then publication date and estimated reading time. Wrap the details onto another line on mobile.",
                              "width": "fill_container",
                              "gap": 16,
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "GpvuX",
                                  "name": "Author identity",
                                  "gap": 8,
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "ellipse",
                                      "id": "Onr2K",
                                      "name": "Aurélien Franky avatar",
                                      "fill": {
                                        "type": "image",
                                        "enabled": true,
                                        "url": "../clients/landing-page/src/assets/authors/aurelien-franky.jpg",
                                        "mode": "fill"
                                      },
                                      "width": 24,
                                      "height": 24
