                    {
                      "type": "text",
                      "id": "tTYch",
                      "name": "Spec",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "First load renders skeleton bars ($ds-surface, radius 4) in place of rows; once content has arrived, reloads keep the previous tree visible instead of flashing back to bones. Placeholder rows — 28px, $ds-fg-subtle, no icon, transparent to hover and skipped by keys — stand in when a section has nothing to say.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
