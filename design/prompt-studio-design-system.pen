                {
                  "type": "frame",
                  "id": "Q0mmn",
                  "name": "Reading the four",
                  "width": 660,
                  "fill": "$ds-bg-subtle",
                  "cornerRadius": 12,
                  "stroke": "$ds-border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 16,
                  "padding": 22,
                  "children": [
                    {
                      "type": "text",
                      "id": "e90rC",
                      "name": "T",
                      "fill": "$ds-fg",
                      "content": "Reading the four",
                      "fontFamily": "$font-heading",
                      "fontSize": 16,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "bf4Ct",
                      "name": "S",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "They are not four versions of one idea. Each answers a different question about what the inbox is for, and the answers are not compatible.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "p40Y0t",
                      "name": "Entries",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 13,
                      "children": [
                        {
                          "type": "frame",
                          "id": "nQS2N",
                          "name": "1 · scoped palette",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "oP0O2",
                              "name": "L",
                              "fill": "$ds-accent",
                              "content": "1 · scoped palette",
                              "fontFamily": "$font-body",
                              "fontSize": 11,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "qZBPP",
                              "name": "D",
                              "fill": "$ds-fg-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Free — it exists. But it is a doorway, not a room: ten items means ten openings, and it forgets you the moment you act. Right answer while the inbox is something you glance at.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "cXvF9",
                          "name": "2 · triage list",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "b8KVob",
                              "name": "L",
                              "fill": "$ds-review",
                              "content": "2 · triage list",
                              "fontFamily": "$font-body",
                              "fontSize": 11,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "zMV90",
                              "name": "D",
                              "fill": "$ds-fg-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The cheapest real gain. Snooze and done are already in the contracts and the API and simply are not drawn today; filters retire the hardcoded groups. Same overlay, same keystroke — a better list inside it.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "S0ZpP",
                          "name": "3 · grouped by resource",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "J7333",
                              "name": "L",
                              "fill": "$ds-info",
                              "content": "3 · grouped by resource",
                              "fontFamily": "$font-body",
                              "fontSize": 11,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "tULFM",
                              "name": "D",
                              "fill": "$ds-fg-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Truest to the model: if a notification is a resource, urgency is a property, not a category. Earns its place when the backlog is deep and clustered, and gets in the way when it is four unrelated things.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "U4T6d",
                          "name": "4 · two-pane",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "s1xwL",
                              "name": "L",
                              "fill": "$ds-warning",
                              "content": "4 · two-pane",
                              "fontFamily": "$font-body",
                              "fontSize": 11,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "M3RuW",
                              "name": "D",
                              "fill": "$ds-fg-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The only one that removes the context switch instead of decorating it. Also the only one that makes the inbox depend on rendering resource detail — which is how a panel quietly turns into a second workbench.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "DK5cp",
                      "name": "Divider 0",
                      "fill": "$ds-border",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "frame",
                      "id": "YCOMm",
                      "name": "Nothing says new",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 5,
                      "children": [
                        {
                          "type": "text",
                          "id": "f8M14",
                          "name": "L",
                          "fill": "$ds-fg-subtle",
                          "content": "WHY NOTHING SAYS “NEW”",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "efXPo",
                          "name": "D",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The inbox holds only what is unresolved, so a New tag states the one property every row already shares — and a read row is a row that should not be here at all. Answer it, snooze it or mark it done and it leaves for Activity, which is the durable record of what happened. Severity survives, carried by the icon rather than a badge; the count in the sidebar header is the only number that means anything, because it is the number of things still waiting.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "YTAMc",
                      "name": "Divider",
                      "fill": "$ds-border",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "frame",
                      "id": "yfg2H",
                      "name": "Not drawn",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 5,
                      "children": [
                        {
                          "type": "text",
                          "id": "IJpw0",
                          "name": "L",
                          "fill": "$ds-fg-subtle",
                          "content": "NOT DRAWN · THE BELL",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "C4i9k0",
                          "name": "D",
                          "fill": "$ds-fg-subtle",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A bell in the chrome with a popover hanging off it is the reflex answer, and PS-95 ruled it out: it makes notifications a fourth kind of overlay with its own anchor, its own dismissal and its own keyboard story, none of which the workbench already knows. The entry point stays in the sidebar header, with a count. Every design above keeps it there.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "bcJn4",
                      "name": "Divider 2",
                      "fill": "$ds-border",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "frame",
                      "id": "x4Hr0",
                      "name": "Lean",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 5,
                      "children": [
                        {
                          "type": "text",
                          "id": "ILom1",
                          "name": "L",
                          "fill": "$ds-fg-subtle",
                          "content": "WHERE THIS LEANS",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "HWhfT",
                          "name": "D",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "2 next: it is the only one whose cost is drawing what the backend already returns. 4 is the real bet, and it is worth taking only once the inbox is where the work starts rather than where it is announced — that is a product question, not a layout one.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
