                          "width": "fill_container",
                          "content": "LATER · What the check catches",
                          "fontFamily": "$font-heading",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "Dyfep",
                          "name": "Body",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A state nothing can reach and that you cannot create into. A state with no successors that nobody marked terminal. A graph with no Create command anywhere, so nothing can get in. All three are graph questions, which is why they could not be asked before.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    }
