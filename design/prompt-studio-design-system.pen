              "name": "Title",
              "fill": "$ds-fg",
              "content": "Kanban renderer",
              "lineHeight": 1.05,
              "fontFamily": "$font-display",
              "fontSize": 44,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "dmE9s",
              "name": "Sub",
              "fill": "$ds-fg-muted",
              "textGrowth": "fixed-width",
              "width": 1180,
              "content": "The renderer draws one set of resources. A single header names the saved views and holds the Filter and Display menus; the body swaps between a detailed list and a kanban board. Display is a setting on the renderer, not a mode of the workbench — which is why a saved view can pin both at once: the filter that narrows the set, and the display that draws it.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
