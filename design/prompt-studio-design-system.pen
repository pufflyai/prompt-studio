          "fontFamily": "Onest",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "zSynU",
          "name": "W1 rule",
          "fill": "$ds-fg-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Changes is a main-region tab beside Session and Terminal. The changed-file tree drives selection; the drawer renders unified diffs per file. Threads anchor to line ranges and open inline under the anchored line; unresolved threads gate approval in the review report.",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
