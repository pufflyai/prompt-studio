                {
                  "type": "frame",
                  "id": "Rxmw3",
                  "name": "Rules",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "fpk7b",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Every breadcrumb that starts with a level page gets a project crumb. Other breadcrumbs stay unchanged.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "RmU0x",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· The project crumb, a click on the active desktop project tab, and the browser project button all go to the last root-level page used in this project.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "i9ovd",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· That page is the part of the location parent chain before the first level page, such as the tickets board for a ticket page.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "x7pMfs",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Moving between levels, such as Sessions to Notes, keeps the saved page. It also survives a reload.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "scvzz",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Start is only the fallback, when no root-level page has been used yet.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DzAMR",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· A click on the active project tab on a root-level page does nothing.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DU8zM",
                      "name": "Rule",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· There is no Back row in the Sidenav.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
