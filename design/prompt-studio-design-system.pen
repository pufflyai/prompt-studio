                                {
                                  "type": "text",
                                  "id": "Lm9Xa",
                                  "name": "N",
                                  "fill": "$ds-accent",
                                  "content": "Settings, the palette and resource modals — siblings of Mode, not children of it",
                                  "fontFamily": "$font-body",
                                  "fontSize": 12,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "XJqB8",
                                  "name": "D",
                                  "fill": "$ds-fg-muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "All three sit inside the project but outside the frame, and none is resource-owned or mode-owned. Settings is an overlay with its own sections nav, where you manage the resources you never select — skills, extensions, agents, tags. The command palette is the same hierarchy as text: each of its groups is one level asking the question it already asks. A resource modal is that palette scoped to one kind, for notifications and the project switcher. None of them disturbs the mode or the selection when it opens.",
                                  "lineHeight": 1.5,
                                  "fontFamily": "$font-body",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                }
