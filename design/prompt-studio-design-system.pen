                              "name": "T",
                              "fill": "$ds-warning",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Preview is tab retention, not a resource-owned Side Panel. Entering a workspace opens its last session as the leftmost preview without forcing a closed panel open. The next navigation replaces or removes that preview; kept-open tabs, order, menus, size, and attached/floating/closed state remain unchanged.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
