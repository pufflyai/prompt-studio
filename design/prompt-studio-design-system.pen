              "fontFamily": "$font-heading",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 1.5
            },
            {
              "type": "text",
              "id": "YYMF2",
              "name": "Title",
              "fill": "$ds-fg",
              "content": "Tree navigation",
              "lineHeight": 1.05,
              "fontFamily": "$font-display",
              "fontSize": 44,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "nRhS0",
              "name": "Sub",
              "fill": "$ds-fg-muted",
              "textGrowth": "fixed-width",
              "width": 1180,
              "content": "The sidenav's spine: a sectioned, keyboard-navigable tree that renders workspaces, file trees, saved views and changed-file lists from one row primitive. Groups collapse, rows nest on a fixed indent scale, file icons resolve per type, actions stay hidden until a row is hovered or focused, and every move the pointer can make has a key. This frame is the visual contract for cmp/TreeRow and the TreeList composite.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 16,
              "fontWeight": "normal"
            },
