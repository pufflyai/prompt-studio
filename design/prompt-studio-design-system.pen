                    },
                    {
                      "type": "text",
                      "id": "mBnIo",
                      "name": "Spec",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The row is its own handle — no grip glyph. The pointer must travel 4px before a drag starts, so clicks stay clicks, and drags follow the pointer vertically only. The pointer's half of the hovered row picks the slot: the upper half drops before it, the lower half after it. Dropping on a group's rows or header joins the group, which tints $ds-accent-subtle; the gap after a group drops behind it, so a row can leave its group as a bare row. Sections reorder among sections, and rows move between sections, including into the header and footer. Nested rows never drag. The lifted row stays in place at 50% opacity; the other rows never shift. The resulting order persists per tree id alongside visibility.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
