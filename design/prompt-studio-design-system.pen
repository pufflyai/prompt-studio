                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "CnG2t",
                          "name": "S",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Carrying. The Side Panel arrangement is project-stable and stays put while you navigate. Resource-driven tabs open as one leftmost preview; Keep Open promotes the preview into the carried arrangement.",
