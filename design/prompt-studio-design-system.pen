                          "content": "WHY NOTHING SAYS “NEW”",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "efXPo",
                          "name": "D",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The inbox holds only what is unresolved, so a New tag states the one property every row already shares — and a read row is a row that should not be here at all. Answer it, snooze it or mark it done and it leaves for Activity, which is the durable record of what happened. Severity survives, carried by the icon rather than a badge; the count in the sidebar header is the only number that means anything, because it is the number of things still waiting.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "YTAMc",
                      "name": "Divider",
                      "fill": "$ds-border",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "frame",
                      "id": "yfg2H",
                      "name": "Not drawn",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 5,
                      "children": [
                        {
                          "type": "text",
                          "id": "IJpw0",
                          "name": "L",
                          "fill": "$ds-fg-subtle",
                          "content": "NOT DRAWN · THE BELL",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "C4i9k0",
                          "name": "D",
                          "fill": "$ds-fg-subtle",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A bell in the chrome with a popover hanging off it is the reflex answer, and PS-95 ruled it out: it makes notifications a fourth kind of overlay with its own anchor, dismissal and keyboard story. The entry point stays in the Sidenav header, with a count. Every design above keeps it there.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "bcJn4",
                      "name": "Divider 2",
                      "fill": "$ds-border",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "frame",
                      "id": "x4Hr0",
                      "name": "Lean",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 5,
                      "children": [
                        {
                          "type": "text",
                          "id": "ILom1",
                          "name": "L",
                          "fill": "$ds-fg-subtle",
                          "content": "WHERE THIS LEANS",
                          "fontFamily": "$font-heading",
                          "fontSize": 10,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "text",
                          "id": "HWhfT",
                          "name": "D",
                          "fill": "$ds-fg-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "2 next: it is the only one whose cost is drawing what the backend already returns. 4 is the real bet, and it is worth taking only once the inbox is where the work starts rather than where it is announced — that is a product question, not a layout one.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
