                    {
                      "type": "text",
                      "id": "XIB2O",
                      "name": "D",
                      "fill": "$ds-fg-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "List mode is a tree, not a table: groups collapse, rows indent beneath them, and attributes ride on the right as chips. The datatable renderer is a different tool for different contexts — it is not what a collection falls back to.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
