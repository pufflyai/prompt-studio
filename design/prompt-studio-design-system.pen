            },
            {
              "type": "text",
              "id": "NDmPK",
              "name": "Section Note",
              "fill": "$ds-fg-muted",
              "content": "Applies independently to Main, Secondary, and Side Panel. Attached menus have no internal header or X. Divider drag closes them; an icon-only dropdown action reattaches.",
              "fontFamily": "$font-body",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "p9R6Y",
              "name": "F09 · Attached, closed, and dropdown menu anatomy",
              "context": "Panel menus default to 280px when attached. Collapsed menu openers use directional panel-left-open and panel-right-open icons rather than the active widget's content icon.",
              "width": "fill_container",
              "fill": "$ds-bg-subtle",
              "cornerRadius": 12,
              "stroke": "$ds-border",
              "strokeWidth": 1,
              "strokeAlignment": "inner",
              "layout": "vertical",
              "gap": 14,
              "padding": 20,
