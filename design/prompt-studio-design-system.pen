                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A node with menuItems opens this on left-click or Enter instead of navigating (right-start, min 200); contextMenuItems opens the same surface on right-click (min 180). Rows are 28px cmp/MenuRow: 14px icon, 13px label, optional 10px description, separatorBefore, and a Kbd hint as end content. Read-only rows render without dismissing the menu; destructive rows ink in $ds-error.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
