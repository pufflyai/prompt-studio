                  "fill": "$ds-fg-muted",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "Every color is theme-aware. Depth is expressed by layering surfaces and hairline borders — never shadows. Pencil variables use ds-* names for the Chakra semantic tokens: ds-bg = bg, ds-bg-subtle = bg.subtle, ds-surface = bg.muted, ds-surface-hover = bg.hover, ds-bg-active = bg.active, ds-panel = bg.panel, ds-focus = border.accent-light, ds-border-accent = border.accent.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
