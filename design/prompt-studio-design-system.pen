                20
              ],
              "children": [
                {
                  "type": "text",
                  "id": "hCioG",
                  "name": "Kicker",
                  "fill": "$ds-fg-subtle",
                  "content": "STUDIES · SELECTING A SET",
                  "fontFamily": "$font-heading",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "P0PMt",
                  "name": "Title",
                  "fill": "$ds-fg",
                  "content": "Workspace list & ticket kanban",
                  "lineHeight": 1.05,
                  "fontFamily": "$font-display",
                  "fontSize": 44,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "M4LS8j",
                  "name": "Sub",
                  "fill": "$ds-fg-muted",
                  "textGrowth": "fixed-width",
                  "width": 1100,
                  "content": "A collection is a selection like any other. The breadcrumb names it, the main slot renders it, and the bottom panel — which belongs to a single resource — is simply not declared: there is no one thing for it to be about. The project-owned slots never notice. One renderer draws both of these: the same set, the same toolbar, the same filters, in its two view modes. List mode is a tree — rows nest under their group and carry their attributes as chips. Board mode buckets those same rows into columns and makes the move a drag. The view is a setting on the renderer, not a mode of the workbench.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "THG9A",
              "name": "View · Workspaces",
