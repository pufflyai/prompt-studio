      "gap": 30,
      "padding": [
        48,
        40
      ],
      "children": [
        {
          "type": "frame",
          "id": "EAKOj",
          "name": "Frame Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "Syb6m",
              "name": "Kicker",
              "fill": "$ds-fg-subtle",
              "content": "COMPONENT · SESSIONSLIST — TREELIST GROUPED BY DATE",
              "fontFamily": "$font-heading",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 1.5
            },
            {
              "type": "text",
              "id": "nfrTC",
              "name": "Title",
              "fill": "$ds-fg",
              "content": "Sessions list",
              "lineHeight": 1.05,
              "fontFamily": "$font-display",
              "fontSize": 44,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "DrPfx",
              "name": "Sub",
              "fill": "$ds-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Session history packaged as cmp/SessionsList: one flat list of past runs bucketed by calendar day, newest day first. Each day is a fixed SecHead group — a date is a bucket, not a branch, so headers never collapse. Each session renders through cmp/TreeListRow at depth 0 with the chevron hidden and the file icon replaced by the session's status. The open session is the active row, hover reveals the row actions, and the title truncates against the row edge.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "iHBqm",
              "name": "Sources",
              "gap": 6,
              "alignItems": "center",
              "children": [
                {
                  "id": "nsAmA",
                  "type": "ref",
                  "ref": "Tboo4",
