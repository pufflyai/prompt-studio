                          "children": [
                            {
                              "type": "text",
                              "id": "zaXnD",
                              "name": "T",
                              "fill": "$ds-fg",
                              "content": "Under 480 the rail floats",
                              "fontFamily": "$font-heading",
                              "fontSize": 12,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "AuJhF",
                              "name": "D",
                              "fill": "$ds-fg-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A 40px gutter is affordable in a full view and not in a sidebar, so below 480 the rail stops reserving space and floats over the log's left edge — the messages keep the full width and gain no padding. Floating is the only mode that overlaps content, so it carries a scrim: $rail-float-fill (the panel's own bg, opaque) fading to $rail-float-fade across 56px. Match the surface it covers, never a lighter one — a scrim in bg.subtle over a bg panel reads as a grey chip stuck to the messages. It fades in on pointer proximity rather than sitting there permanently.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
