          "type": "text",
          "id": "QqJhK",
          "name": "Section title",
          "fill": "$ds-fg",
          "content": "F26 · Workspace view — changes diff review, review report, files editor",
          "fontFamily": "Onest",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "j3olt3",
          "name": "Rule",
          "fill": "$ds-fg-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Three production surfaces for the workspace mode. Changes, Review report, and Files are sibling main-region tabs beside Session and Terminal. Review comment threads share one pattern: they anchor to diff line ranges in the Changes tab and to change requests in the report. The session stays in the Side Panel; terminal keeps the Secondary Panel in the editor.",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "fHbgJ",
          "name": "W1 title",
