{
  "name": "pstdio-account-manager",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/environment-access.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts src/environment-access.ts src/server.ts --target bun --outdir dist && bun build scripts/account-feature.ts --target bun --outfile dist/account-feature.js",
    "account-feature": "bun scripts/account-feature.ts",
    "start": "bun ./dist/server.js",
    "test:isolated": "bun scripts/test-isolated.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "pstdio-sync-contracts": "workspace:*",
    "zod": "^4.3.6",
    "pstdio-service-telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "6.0.2"
  }
}
