{
  "name": "pstdio-relay",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/server.ts src/index.ts --target bun --outdir dist",
    "start": "bun ./dist/server.js",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "test": "bun test src",
    "test:storage": "SYNC_TEST_ENTRY=../../services/relay/src/storage/storage.integration.ts bun ../../packages/pstdio-sync-contracts/scripts/isolated.ts ../../services/relay/src/storage/crash.integration.ts ../../services/relay/src/storage/resolution.integration.ts",
    "test:assets": "SYNC_TEST_ENTRY=../../services/relay/src/assets/assets.integration.ts bun ../../packages/pstdio-sync-contracts/scripts/isolated.ts ../../services/relay/src/assets/integrity.integration.ts ../../services/relay/src/assets/recovery.integration.ts ../../services/relay/src/assets/transfers.integration.ts ../../services/relay/src/assets/lifecycle.integration.ts ../../services/relay/src/assets/objects.contract.integration.ts ../../services/relay/src/assets/probe-cleanup.integration.ts ../../services/relay/src/assets/range.integration.ts ../../services/relay/src/assets/streams.test.ts ../../services/relay/src/assets/database-shutdown.integration.ts",
    "test:transport": "SYNC_TEST_ENTRY=../../services/relay/src/transport/transport.integration.ts bun ../../packages/pstdio-sync-contracts/scripts/isolated.ts ../../services/relay/src/transport/requests.integration.ts ../../services/relay/src/transport/assets.integration.ts ../../services/relay/src/transport/subscriptions.integration.ts ../../services/relay/src/transport/lifecycle.integration.ts ../../services/relay/src/transport/isolation.integration.ts ../../services/relay/src/transport/notification-order.integration.ts ../../services/relay/src/transport/streams.integration.ts ../../services/relay/src/transport/shutdown.integration.ts ../../services/relay/src/transport/native-client.integration.ts ../../services/relay/src/transport/local-enrollment.integration.ts ../../services/relay/src/transport/native-connection.integration.ts ../../services/relay/src/transport/pending-hints.integration.ts ../../services/relay/src/transport/recovery.integration.ts ../../services/relay/src/transport/asset-verification-cancellation.integration.ts ../../services/relay/src/transport/scope-registration.integration.ts ../../services/relay/src/transport/telemetry.integration.ts",
    "test:sync": "SYNC_TEST_ENTRY=../../services/relay/src/storage/sync.integration.ts bun ../../packages/pstdio-sync-contracts/scripts/isolated.ts ../../services/relay/src/storage/sync-privacy.integration.ts ../../services/relay/src/storage/sync-bound.integration.ts ../../services/relay/src/transport/sync.integration.ts ../../services/relay/src/transport/document-client.integration.ts ../../services/relay/src/storage/blob-graph.integration.ts ../../services/relay/src/storage/blob-retirement.integration.ts",
    "bench:storage-bound": "bun scripts/storage-bound.bench.ts",
    "test:objects": "bun test src/assets/objects.contract.integration.ts",
    "test:isolated": "bun scripts/test-isolated.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "pstdio-account-manager": "workspace:*",
    "pstdio-service-telemetry": "workspace:*",
    "pstdio-sync": "workspace:*",
    "pstdio-sync-contracts": "workspace:*",
    "zod": "^4.3.6"
  }
}
