{
  "name": "pstdio-relay",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/server.ts src/index.ts --target bun --outdir dist",
    "start": "bun ./dist/server.js",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "typecheck": "bun check",
    "lint": "bun run typecheck && biome check .",
    "test": "bun ../../scripts/ci/run-bun-tests.ts",
    "bench:storage-bound": "bun scripts/storage-bound.p3.bench.ts",
    "test:integration": "bun scripts/test-isolated.ts && bun ../../packages/pstdio-sync-contracts/scripts/isolated.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "pstdio-account-manager": "workspace:*",
    "pstdio-service-telemetry": "workspace:*",
    "pstdio-sync": "workspace:*",
    "pstdio-sync-contracts": "workspace:*",
    "zod": "^4.3.6"
  }
}
