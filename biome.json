{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/build",
      "!!**/coverage",
      "!!**/dist",
      "!!**/.nx",
      "bun.lock",
      "!!packages/pstdio-dashboard/chakra-config.json",
      "!!packages/e2e/playwright-report",
      "!!packages/e2e/test-results",
      "!!packages/storybook-tests/playwright-report",
      "!!packages/storybook-tests/test-results",
      "!!packages/pstdio-extensions/src/bridge/webview-runtime/runtime.bundle.js",
      "!!packages/pstdio-agents/src/providers/opencode/mocks/full-conversation.json"
    ]
  },
  "formatter": {
    "lineWidth": 120,
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "noUselessElse": "error",
        "noNestedTernary": "error"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 180,
            "skipBlankLines": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "nursery": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 350,
            "skipBlankLines": true
          }
        }
      },
      "a11y": {
        "useButtonType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.integration.ts",
        "**/*.fixture.ts",
        "**/*.fixture.tsx",
        "**/*.fixtures.ts",
        "**/*.bench.ts",
        "**/*.perf.ts",
        "**/*.stress.ts",
        "**/*.diagnostic.ts",
        "**/*test-utils.ts",
        "**/test-utils/**",
        "**/mocks/**",
        "packages/e2e/**",
        "clients/desktop/src/e2e/**",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*.css",
        "**/*.generated.*",
        "**/generated/**",
        "**/__generated__/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
