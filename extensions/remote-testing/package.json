{
  "name": "remote-testing",
  "version": "0.1.0",
  "displayName": "Remote Testing",
  "description": "Run this repository's test suite on a remote PocketCoder deployment and manage its test environments.",
  "publisher": "pocketcoder",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.5.1 || ^0.6.0"
  },
  "pstdio": {
    "scope": "user",
    "projectFiles": {
      "tracked": false
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 10000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pstdio/sdk": "0.48.0-nightly.20261117030256"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
