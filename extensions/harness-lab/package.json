{
  "name": "harness-lab",
  "version": "0.1.0",
  "displayName": "Harness Lab",
  "description": "Deterministic lab harness for tests. Not seeded by default.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^1.0.0"
  },
  "pstdio": {
    "scope": "user"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --silent",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@pstdio/sdk": "^0.13.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "6.0.2"
  }
}
