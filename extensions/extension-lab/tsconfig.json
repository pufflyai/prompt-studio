{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@pstdio/ui": ["../../packages/ui/dist/index.d.ts"],
      "@pstdio/ui/style.css": ["../../packages/ui/dist/style.css"],
      "@chakra-ui/react": ["../../packages/ui/node_modules/@chakra-ui/react"]
    }
  },
  "include": ["extension.ts", "src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
