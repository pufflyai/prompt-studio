{
  "name": "harness-open-code",
  "version": "0.45.0",
  "displayName": "OpenCode",
  "description": "Contributes the OpenCode agent harness.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.3.0"
  },
  "pstdio": {
    "scope": "user"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/ci/run-bun-tests.ts --silent",
    "test:coverage": "bun ../../scripts/ci/run-bun-tests.ts --coverage",
    "typecheck": "bun check",
    "lint": "bun run typecheck && biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@pstdio/sdk": "^0.41.0",
    "opencode-ai": "1.18.34"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.2"
  }
}
