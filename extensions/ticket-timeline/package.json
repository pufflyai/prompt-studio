{
  "name": "ticket-timeline",
  "publisher": "kito",
  "displayName": "Ticket timeline",
  "description": "Show Planner tickets on a timeline with deadlines, dependencies, and blockers.",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.1.0",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "pstdio": {
    "scope": "repo"
  },
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "lint": "bun run typecheck && biome check .",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "^11.0.0",
    "@pstdio/sdk": "0.39.0",
    "@pstdio/ui": "0.39.0",
    "lucide-react": "^0.556.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  }
}
