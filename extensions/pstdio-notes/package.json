{
  "name": "pstdio-notes",
  "version": "0.45.0",
  "displayName": "Notes",
  "description": "Write Markdown notes that live in the project repository.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.2.1 || ^0.3.0"
  },
  "pstdio": {
    "scope": "user"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/ci/run-bun-tests.ts",
    "test:coverage": "bun ../../scripts/ci/run-bun-tests.ts --coverage",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@pstdio/sdk": "^0.45.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.2"
  }
}
