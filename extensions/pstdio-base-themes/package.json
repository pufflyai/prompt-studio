{
  "name": "pstdio-base-themes",
  "version": "0.45.0",
  "displayName": "Prompt Studio Base Themes",
  "description": "Bundled color themes (Monokai, Solarized, Dracula) and the Seti file icon theme.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "files": [
    "extension.ts",
    "themes",
    "icons"
  ],
  "engines": {
    "pstdio": "^0.1.0 || ^0.2.0 || ^0.3.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../../scripts/ci/run-bun-tests.ts --pass-with-no-tests",
    "typecheck": "bun check && bun check -p tsconfig.canvas.json",
    "build:preview-tests": "storybook build --config-dir .canvas --output-dir canvas-test-static"
  },
  "dependencies": {
    "@pstdio/sdk": "^0.35.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "11.14.0",
    "@pstdio/ui": "^0.43.1",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.6.0",
    "typescript": "6.0.2",
    "vite": "^8.3.1"
  }
}
