  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "scope": ["variable", "constant"],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "scope": "number",
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#cb4b16"
      }
    }
  ],
