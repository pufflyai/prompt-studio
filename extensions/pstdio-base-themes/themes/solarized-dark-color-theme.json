{
  "name": "Solarized Dark",
  "type": "dark",
  "colors": {
    "foreground": "#ffffff",
    "descriptionForeground": "#ffffff",
    "disabledForeground": "#839496",
    "focusBorder": "#2AA19899",
    "border": "#2b2b4a",
    "selection.background": "#2AA19899",
    "editor.background": "#002B36",
    "editor.foreground": "#ffffff",
    "editor.lineHighlightBackground": "#073642",
    "editor.selectionBackground": "#274642",
    "editorCursor.foreground": "#D30102",
    "editorWhitespace.foreground": "#93A1A180",
    "editorIndentGuide.background1": "#93A1A180",
    "editorIndentGuide.activeBackground1": "#C3E1E180",
    "editorWidget.background": "#00212B",
    "sideBar.background": "#00212B",
    "panel.background": "#00212B",
    "panel.border": "#2b2b4a",
    "activityBar.background": "#003847",
    "statusBar.background": "#00212B",
    "statusBar.foreground": "#ffffff",
    "input.background": "#003847",
    "input.foreground": "#ffffff",
    "input.border": "#2AA19899",
    "dropdown.background": "#00212B",
    "dropdown.border": "#2AA19899",
    "menu.background": "#00212B",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#005A6F",
    "list.activeSelectionBackground": "#005A6F",
    "list.hoverBackground": "#004454AA",
    "list.inactiveSelectionBackground": "#00445488",
    "list.highlightForeground": "#1ebcc5",
    "badge.background": "#047aa6",
    "badge.foreground": "#ffffff",
    "button.background": "#2AA19899",
    "button.hoverBackground": "#2AA19899",
    "button.foreground": "#ffffff",
    "diffEditor.insertedTextBackground": "#85990033",
    "diffEditor.removedTextBackground": "#dc322f33",
    "gitDecoration.addedResourceForeground": "#859900",
    "gitDecoration.deletedResourceForeground": "#dc322f"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": { "foreground": "#586e75", "fontStyle": "italic" }
    },
    { "scope": "string", "settings": { "foreground": "#2aa198" } },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#859900" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#268bd2" }
    },
    {
      "scope": ["variable", "constant"],
      "settings": { "foreground": "#b58900" }
    },
    { "scope": "number", "settings": { "foreground": "#d33682" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#cb4b16" } }
  ]
}
