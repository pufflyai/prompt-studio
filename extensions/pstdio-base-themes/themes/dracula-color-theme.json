  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6272A4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#F1FA8C"
      }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#50FA7B"
      }
    },
    {
      "scope": ["variable", "constant"],
      "settings": {
        "foreground": "#8BE9FD"
      }
    },
    {
      "scope": "number",
      "settings": {
        "foreground": "#BD93F9"
      }
    }
