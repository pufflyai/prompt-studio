{
  "name": "pstdio-planner",
  "version": "0.43.1",
  "displayName": "Prompt Studio Planner",
  "description": "Built-in Prompt Studio planner: tickets, managed attempts, reviews, and templates.",
  "publisher": "pstdio",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.1.2 || ^0.2.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/build/build-planner-filter-control.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "nx": {
    "implicitDependencies": [
      "@pstdio/ui"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/scripts/build/build-planner-filter-control.ts"
        ],
        "outputs": [
          "{projectRoot}/vendor"
        ]
      }
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.0.0",
    "@pstdio/sdk": "^0.43.1",
    "@pstdio/ui": "0.43.1",
    "@tanstack/react-query": "^5.90.21",
    "lucide-react": "^0.557.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.0",
    "@types/bun": "1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^10.6.0",
    "typescript": "6.0.2"
  }
}
