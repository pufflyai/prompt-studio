    "build": "bun scripts/verify-migration-coverage.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.32.0",
    "@emotion/react": "^11.0.0",
    "@pstdio/sdk": "0.46.0-nightly.20261026030503",
    "@pstdio/ui": "0.46.0-nightly.20261026030503",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "6.0.2"
  },
  "nx": {
    "implicitDependencies": [
      "@pstdio/ui",
      "@pstdio/workbench"
