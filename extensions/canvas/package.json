{
  "name": "canvas",
  "version": "0.0.0",
  "displayName": "UI Canvas",
  "description": "Designs, component states, and interactive examples in one UI workspace.",
  "publisher": "pstdio",
  "private": true,
  "type": "module",
  "main": "./extension.ts",
  "engines": {
    "pstdio": "^0.3.0"
  },
  "scripts": {
