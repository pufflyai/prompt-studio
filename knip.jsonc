{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  // `check` is a built-in Bun command, not a dependency binary.
  "ignoreBinaries": [
    "check",
    "gh",
    "wait",
    "version",
    // Candidate workflows sparsely check out these installer files at runtime; see ADR 0028.
    "__test-tmp__/native-installer/scripts/ci/install-native-dependencies.ts"
  ],
  "ignoreIssues": {
    "packages/pstdio/src/adapters/cli/commands/{close,inbox,login,logout,logs,performance,update-channel}.ts": [
      "exports"
    ],
    "packages/pstdio/src/adapters/cli/commands/notifications/list.ts": ["exports"],
    "packages/pstdio-api/src/features/extensions/extension-webviews.ts": ["types"],
    "packages/pstdio-api/src/features/extensions/repo-extensions.ts": ["types"],
    "packages/pstdio-api/src/services/extension-asset-catalog.ts": ["types"],
    "packages/sdk/src/api/workspaces.ts": ["types"],
    "packages/pstdio-api-contracts/src/workspaces.ts": ["duplicates"],
    "packages/pstdio-db/src/db/schemas.zod.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": ["package.json", "knip.jsonc"],
      "project": ["*.json", "*.jsonc"],
      "ignore": [".pstdio/**"],
      // scripts/ci/install-native-dependencies.ts points npm_config_node_gyp at this package's binary.
      "ignoreDependencies": ["node-gyp"]
    },
    "services/telemetry": {
      "entry": ["src/telemetry.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"]
    },
    "services/account-manager": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "src/**/*.test.ts",
        "src/**/*.integration.ts",
        "src/**/*.fixture.ts",
        "scripts/*.ts",
        "drizzle.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts"],
      "ignore": ["dist/**"]
    },
    "services/psx": {
      "entry": ["src/index.ts", "src/server.ts", "src/**/*.integration.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "drizzle.config.ts"],
      "ignore": ["dist/**"]
    },
    "services/relay": {
      "entry": [
        "package.json",
        "drizzle.config.ts",
        "src/index.ts",
        "src/server.ts",
        "src/**/*.test.ts",
        "src/**/*.integration.ts",
        "src/**/*.fixture.ts",
        "scripts/*.ts"
      ],
      "project": ["*.ts", "src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["dist/**"]
    },
    "scripts": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/*": {
      "entry": [
        "package.json",
        "src/index.ts",
        "src/**/index.ts",
        // The shared workbench target contracts are imported outside this workspace.
        "src/extension-kernel/workbench-targets.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        // Isolated integration tests are launched by scripts with explicit paths.
        "src/**/*.integration.ts",
        // Tests spawn fixtures by path, so nothing imports them.
        "src/**/*.fixture.ts",
        "src/**/*.bench.ts",
        "src/**/*.diagnostic.ts",
        "src/**/*.typecheck.ts",
        "src/**/*.canvas.tsx",
        "*.test.ts",
        "*.test.tsx",
        "scripts/**/*.ts",
        "bin/**/*.cjs"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}", "scripts/**/*.ts", "bin/**/*.cjs"],
      "ignore": ["dist/**", "canvas-test-static/**"]
    },
    "packages/canvas-tests": {
      "entry": ["playwright.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/scripts/*.ts"],
      "project": ["playwright.config.ts", "src/**/*.ts"],
      "ignore": ["playwright-report/**", "test-results/**"],
      "ignoreDependencies": ["@pstdio/ui", "@pstdio/workbench", "pstdio-dashboard"]
    },
    "packages/e2e": {
      "entry": [
        "playwright*.config.ts",
        "src/cli/run-pstdio.ts",
        // Playwright launches the prepared test runtime through a command string.
        "src/scripts/serve-ui.ts",
        "src/scripts/bun-process-cleanup.ts",
        "src/**/*.spec.ts",
        "src/**/*.perf.ts",
        "src/**/*.bench.ts",
        "src/perf/planner-moves.stress.ts",
        "src/perf/planner-moves.validation.ts",
        // These diagnostics compile or launch fixture modules by path.
        "src/perf/storage-scale-container-setup.ts",
        "src/perf/storage-scale-container-entry.ts",
        "src/perf/storage-scale-case.ts",
        "src/perf/storage-scale-prepare.ts",
        "src/perf/storage-scale-extension.ts",
        "src/**/*.test.ts",
        "src/**/*.fixture.ts",
        "src/**/*.fixture.tsx",
        // Packaged smoke tests bundle these extension entries by path.
        "src/packaged/fixtures/*-extension.ts",
        // Specs install fixture extensions by path.
        "src/fixtures/**/extension.ts",
        // Extension manifests load this webview entry by packageAsset path.
        "src/fixtures/editing-session/view.ts"
      ],
      "project": ["playwright*.config.ts", "src/**/*.ts"],
      "ignore": ["playwright-report/**", "screenshots/**", "test-results/**"],
      // Extensions e2e installs at runtime by path, and the dashboard it builds and serves.
      // Declared so CI treats their changes as e2e changes.
      "ignoreDependencies": [
        "extension-lab",
        "harness-claude-code",
        "harness-codex",
        "harness-open-code",
        "harness-pi",
        "local-example",
        "pstdio-artifacts",
        "pstdio-base-themes",
        "pstdio-dashboard",
        "pstdio-notes",
        "pstdio-planner",
        "pstdio-reports",
        "pstdio-skills",
        "remote-workspaces",
        "workbench-fixture"
      ]
    },
    "packages/pstdio-api": {
      "entry": [
        "package.json",
        "src/index.ts",
        "src/server.ts",
        "src/features/workspaces/worktree-cleanup.p3.bench.ts",
        "src/**/*.test.ts",
        // The isolated conformance runner launches these by path.
        "src/**/*.integration.ts",
        "src/**/*.fixture.ts",
        "src/**/*.canvas.tsx"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"],
      // Tests install these extensions and fixtures from source. Declared so CI treats their changes as API changes.
      "ignoreDependencies": [
        "extension-lab",
        "pstdio-base-themes",
        "pstdio-planner",
        "pstdio-skills",
        "workbench-fixture"
      ]
    },
    "packages/pstdio-db": {
      "entry": [
        "drizzle.config.ts",
        "scripts/**/*.ts",
        "src/index.ts",
        // The database asset build bundles this isolated child entrypoint by path.
        "src/db/pglite-export-worker.ts",
        "src/services/sessions/session-query.p3.bench.ts",
        "src/services/extension-storage/document-storage.p3.bench.ts",
        "src/services/extension-storage/document-scale.diagnostic.ts",
        "src/services/extension-storage/record-read-scale.diagnostic.ts",
        "src/**/*.test.ts",
        // The isolated conformance runner and durability tests launch these by path.
        "src/**/*.integration.ts",
        "src/**/*.fixture.ts",
        "src/**/*.canvas.tsx"
      ],
      "project": ["drizzle.config.ts", "scripts/**/*.ts", "src/**/*.ts"],
      "ignore": ["dist/**", "vendor/**"]
    },
    "packages/pstdio-dashboard": {
      "entry": [
        "vite.config.ts",
        ".canvas/**/*.{ts,tsx}",
        "src/main.tsx",
        "src/**/*.canvas.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "*.test.ts"
      ],
      "project": ["*.ts", ".canvas/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "canvas-test-static/**"]
    },
    "packages/pstdio-extension-testbench": {
      "entry": [
        "vite.config.ts",
        "src/main.tsx",
        "src/lib/testbench-api-server.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        // Tests load fixture extensions by path.
        "src/lib/fixtures/**/extension.ts"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"],
      // Tests load these extensions from source. Declared so CI treats their changes as testbench changes.
      "ignoreDependencies": ["pstdio-base-themes", "pstdio-planner"]
    },
    "packages/pstdio-extensions": {
      "entry": [
        "package.json",
        "scripts/**/*.ts",
        "src/index.ts",
        "src/bridge/guest/bootstrap.ts",
        "src/**/*.test.ts",
        "src/**/*.fixture.ts",
        "src/**/*.canvas.tsx"
      ],
      "project": ["scripts/**/*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"],
      // Tests load the documented examples from source. Declared so CI treats their changes as extension runtime changes.
      "ignoreDependencies": ["extension-lab"]
    },
    "packages/sdk": {
      "entry": [
        "package.json",
        "rolldown.*.config.ts",
        "src/{api,client,extensions,extensions/react,prompts,hooks,resources,testing,data}/index.ts",
        "src/**/*.test.ts",
        "src/**/*.typecheck.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"],
      // Public declarations inline private contracts, including their Zod types.
      "ignoreDependencies": ["pstdio-sync-contracts", "zod"]
    },
    "packages/pstdio-workbench": {
      "entry": [
        "package.json",
        ".canvas/**/*.{ts,tsx}",
        "rolldown.*.config.ts",
        "src/index.ts",
        "src/{core,react,storage,testing,extensions,webview-runtime}/index.ts",
        "src/**/*.canvas.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        // The packaged browser test bundles these two public-consumer entries by path.
        "src/react/settings/settings-lifetime.fixture.tsx",
        "src/react/settings/settings-lifetime-guest.fixture.ts",
        "src/**/*.typecheck.ts"
      ],
      "project": [".canvas/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "canvas-test-static/**"],
      // The build inlines private contracts and extensions (build-entries.ts); sync types also enter via tsconfig.build.json.
      "ignoreDependencies": ["pstdio-sync-contracts", "rimless", "zod"]
    },
    "packages/ui": {
      "entry": [
        "package.json",
        "vite.config.ts",
        "vite.monaco.config.ts",
        "rolldown.*.config.ts",
        "playwright.*.config.ts",
        ".canvas/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        // Keep in sync with build-entries.ts and vite.monaco.config.ts.
        "src/index.ts",
        "src/theme/index.ts",
        "src/components/{canvas,dependency-timeline,rich-text,chat-ui,diff-viewer,kanban-renderer,collection-view,param-editor,data-table,mermaid-renderer,terminal}/index.ts",
        "src/components/diff-viewer/monaco-bundle.ts",
        "src/**/*.canvas.tsx",
        "*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": ["*.ts", ".canvas/**/*.{ts,tsx}", "scripts/**/*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "canvas-test-static/**"]
    },
    "packages/workbench-fixture": {
      // Views are webview entries that extension.ts references by path.
      "entry": ["extension.ts", "src/**/*.canvas.tsx", "*.test.ts", "src/**/*.test.ts", "src/views/*.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-base-themes": {
      "entry": ["package.json", "extension.ts", "*.test.ts", ".canvas/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}"],
      "project": ["*.ts", ".canvas/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}"]
    },
    "extensions/*": {
      // Tests launch fixture scripts by path.
      "entry": [
        "package.json",
        "extension.ts",
        "*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.fixture.ts",
        "src/**/*.canvas.tsx"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"],
      // Harnesses resolve these native executables through package metadata rather than imports.
      "ignoreDependencies": ["@openai/codex", "@anthropic-ai/claude-code", "opencode-ai"]
    },
    // Webview entries are referenced by path through packageAsset(), so each extension lists its own.
    "extensions/extension-lab": {
      "entry": ["package.json", "extension.ts", "*.test.ts", "src/**/*.test.ts", "src/views/*.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-artifacts": {
      "entry": [
        "package.json",
        "extension.ts",
        "*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.canvas.tsx",
        "src/{view,open-artifact}.tsx"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-planner": {
      "entry": [
        "package.json",
        "extension.ts",
        "*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/views/tags-settings-panel.tsx",
        "src/views/status-settings-panel.tsx",
        "src/views/ticket-review-requests.tsx",
        "src/commands/reorder-ticket.stress.fixture.ts",
        "src/timeline/view/entry.tsx",
        "src/**/*.canvas.tsx"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-skills": {
      // The skill's example extensions are typechecked source.
      "entry": [
        "extension.ts",
        "src/**/*.canvas.tsx",
        "*.test.ts",
        "skills/create-pstdio-extension/references/examples/**/*.{ts,tsx}"
      ],
      "project": ["*.ts", "skills/create-pstdio-extension/references/examples/**/*.{ts,tsx}"]
    },
    "infra/local/extensions/*": {
      "entry": ["extension.ts", "src/**/*.canvas.tsx", "*.test.ts"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "clients/desktop": {
      "entry": [
        "forge.config.ts",
        "vite.config.ts",
        "playwright*.config.ts",
        ".canvas/**/*.{ts,tsx}",
        "scripts/**/*.{ts,tsx}",
        // Built by the build:main and build:preload scripts.
        "src/main.ts",
        "src/preload.ts",
        "src/renderer/src.tsx",
        // Specs launch these fixtures by path.
        "src/e2e/*-fixture.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.canvas.tsx"
      ],
      "project": ["*.ts", ".canvas/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "out/**"],
      // forge.config.ts names these makers as strings.
      "ignoreDependencies": ["@electron-forge/maker-deb", "@electron-forge/maker-squirrel", "@electron-forge/maker-zip"]
    },
    "clients/*": {
      "entry": [
        "package.json",
        "astro.config.*",
        ".canvas/**/*.{ts,tsx}",
        "src/**/*.canvas.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/pages/**/*.{astro,md,mdx,ts,tsx}",
        "src/layouts/**/*.astro",
        // Loaded by a <script src> tag in base-layout.astro.
        "src/services/analytics.ts"
      ],
      "project": ["*.{ts,mjs}", "src/**/*.{astro,ts,tsx,md,mdx}"],
      "ignore": ["dist/**"]
    }
  }
}
