{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["wait", "version"],
  "ignoreIssues": {
    "packages/pstdio/src/adapters/cli/commands/{close,inbox,logs,performance}.ts": ["exports"],
    "packages/pstdio/src/adapters/cli/commands/notifications/list.ts": ["exports"],
    "packages/pstdio-api/src/features/extensions/extension-webviews.ts": ["types"],
    "packages/pstdio-api/src/features/extensions/repo-extensions.ts": ["types"],
    "packages/pstdio-api/src/services/extension-asset-catalog.ts": ["types"],
    "packages/sdk/src/api/workspaces.ts": ["types"],
    "packages/pstdio-api-contracts/src/workspaces.ts": ["duplicates"],
    "packages/pstdio-db/src/db/schemas.zod.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": ["package.json", "knip.jsonc"],
      "project": ["*.json", "*.jsonc"],
      "ignore": [".pstdio/**"],
      // scripts/ci/install-native-dependencies.ts points npm_config_node_gyp at this package's binary.
      "ignoreDependencies": ["node-gyp"]
    },
    "scripts": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/*": {
      "entry": [
        "package.json",
        "src/index.ts",
        "src/**/index.ts",
        // The shared workbench target contracts are imported outside this workspace.
        "src/extension-kernel/workbench-targets.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        // Tests spawn fixtures by path, so nothing imports them.
        "src/**/*.fixture.ts",
        "src/**/*.typecheck.ts",
        "*.test.ts",
        "scripts/**/*.ts",
        "bin/**/*.cjs"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}", "scripts/**/*.ts", "bin/**/*.cjs"],
      "ignore": ["dist/**", "storybook-static/**"]
    },
    "packages/e2e": {
      "entry": [
        "playwright.config.ts",
        "src/cli/run-pstdio.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.fixture.ts",
        // Specs install fixture extensions by path.
        "src/fixtures/**/extension.ts"
      ],
      "project": ["playwright.config.ts", "src/**/*.ts"],
      "ignore": ["playwright-report/**", "screenshots/**", "test-results/**"],
      // Extensions e2e installs at runtime by path, and the dashboard it builds and serves.
      // Declared so CI treats their changes as e2e changes.
      "ignoreDependencies": [
        "extension-lab",
        "harness-claude-code",
        "harness-codex",
        "harness-open-code",
        "local-example",
        "pstdio-artifacts",
        "pstdio-base-themes",
        "pstdio-dashboard",
        "pstdio-notes",
        "pstdio-planner",
        "pstdio-reports",
        "pstdio-skills",
        "remote-workspaces",
        "workbench-fixture"
      ]
    },
    "packages/pstdio-api": {
      "entry": ["package.json", "src/index.ts", "src/server.ts", "src/**/*.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"],
      // Tests install these core extensions from source. Declared so CI treats their changes as API changes.
      "ignoreDependencies": ["extension-lab", "pstdio-planner", "pstdio-skills"]
    },
    "packages/pstdio-db": {
      "entry": ["drizzle.config.ts", "scripts/**/*.ts", "src/index.ts", "src/**/*.test.ts"],
      "project": ["drizzle.config.ts", "scripts/**/*.ts", "src/**/*.ts"],
      "ignore": ["dist/**", "vendor/**"]
    },
    "packages/pstdio-dashboard": {
      "entry": [
        "vite.config.ts",
        ".storybook/**/*.{ts,tsx}",
        "src/main.tsx",
        "src/**/*.stories.tsx",
        "src/**/*.test.ts"
      ],
      "project": ["*.ts", ".storybook/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "storybook-static/**"]
    },
    "packages/pstdio-extension-testbench": {
      "entry": [
        "vite.config.ts",
        "src/main.tsx",
        "src/lib/testbench-api-server.ts",
        "src/**/*.test.ts",
        // Tests load fixture extensions by path.
        "src/lib/fixtures/**/extension.ts"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"]
    },
    "packages/pstdio-extensions": {
      "entry": [
        "package.json",
        "scripts/**/*.ts",
        "src/index.ts",
        "src/bridge/guest/bootstrap.ts",
        "src/**/*.test.ts",
        "src/**/*.fixture.ts"
      ],
      "project": ["scripts/**/*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"]
    },
    "packages/sdk": {
      "entry": [
        "package.json",
        "rolldown.*.config.ts",
        "src/{api,client,extensions,extensions/react,prompts,hooks,resources,testing,data}/index.ts",
        "src/**/*.test.ts",
        "src/**/*.typecheck.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"]
    },
    "packages/pstdio-workbench": {
      "entry": [
        "package.json",
        ".storybook/**/*.{ts,tsx}",
        "rolldown.*.config.ts",
        "src/index.ts",
        "src/{core,react,storage,testing,extensions,webview-runtime}/index.ts",
        "src/**/*.stories.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.typecheck.ts"
      ],
      "project": [".storybook/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "storybook-static/**"],
      // The build inlines pstdio-extensions and pstdio-api-contracts (build-entries.ts), so dist imports their dependencies.
      "ignoreDependencies": ["rimless", "zod"]
    },
    "packages/ui": {
      "entry": [
        "package.json",
        "vite.config.ts",
        "vite.monaco.config.ts",
        "rolldown.*.config.ts",
        "playwright.*.config.ts",
        ".storybook/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        // Keep in sync with build-entries.ts and vite.monaco.config.ts.
        "src/index.ts",
        "src/theme/index.ts",
        "src/components/{rich-text,chat-ui,diff-viewer,kanban-renderer,param-editor,data-table,mermaid-renderer,terminal}/index.ts",
        "src/components/diff-viewer/monaco-bundle.ts",
        "src/**/*.stories.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": ["*.ts", ".storybook/**/*.{ts,tsx}", "scripts/**/*.ts", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "storybook-static/**"]
    },
    "packages/workbench-fixture": {
      // Views are webview entries that extension.ts references by path.
      "entry": ["extension.ts", "*.test.ts", "src/**/*.test.ts", "src/views/*.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/*": {
      "entry": ["package.json", "extension.ts", "*.test.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    // Webview entries are referenced by path through packageAsset(), so each extension lists its own.
    "extensions/extension-lab": {
      "entry": ["package.json", "extension.ts", "*.test.ts", "src/**/*.test.ts", "src/views/*.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-artifacts": {
      "entry": ["package.json", "extension.ts", "*.test.ts", "src/**/*.test.ts", "src/{view,open-artifact}.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-planner": {
      "entry": [
        "package.json",
        "extension.ts",
        "*.test.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/views/tags-settings-panel.tsx",
        "src/timeline/view/entry.tsx"
      ],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "extensions/pstdio-skills": {
      // The skill's example extensions are typechecked source.
      "entry": ["extension.ts", "*.test.ts", "skills/create-pstdio-extension/references/examples/**/*.{ts,tsx}"],
      "project": ["*.ts", "skills/create-pstdio-extension/references/examples/**/*.{ts,tsx}"]
    },
    "infra/local/extensions/*": {
      "entry": ["extension.ts", "*.test.ts"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "clients/desktop": {
      "entry": [
        "forge.config.ts",
        "vite.config.ts",
        "playwright*.config.ts",
        ".storybook/**/*.{ts,tsx}",
        "scripts/**/*.{ts,tsx}",
        // Built by the build:main and build:preload scripts.
        "src/main.ts",
        "src/preload.ts",
        "src/renderer/src.tsx",
        // Specs launch these fixtures by path.
        "src/e2e/*-fixture.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.stories.tsx"
      ],
      "project": ["*.ts", ".storybook/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "out/**"],
      // forge.config.ts names these makers as strings.
      "ignoreDependencies": ["@electron-forge/maker-deb", "@electron-forge/maker-squirrel", "@electron-forge/maker-zip"]
    },
    "clients/*": {
      "entry": [
        "package.json",
        "astro.config.*",
        "src/pages/**/*.{astro,md,mdx,ts,tsx}",
        "src/layouts/**/*.astro",
        // Loaded by a <script src> tag in base-layout.astro.
        "src/services/analytics.ts"
      ],
      "project": ["*.{ts,mjs}", "src/**/*.{astro,ts,tsx,md,mdx}"],
      "ignore": ["dist/**"]
    }
  }
}
