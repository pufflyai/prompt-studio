FROM oven/bun:1.4.2 AS build
WORKDIR /build
COPY package.json bun.lock bunfig.toml ./
COPY infra/telemetry/package.json ./infra/telemetry/package.json
COPY infra/account-manager/package.json ./infra/account-manager/package.json
COPY packages/pstdio-sync-contracts/package.json ./packages/pstdio-sync-contracts/package.json
RUN bun install --frozen-lockfile --production --filter pstdio-account-manager
COPY infra/account-manager/src ./infra/account-manager/src
COPY infra/telemetry/src ./infra/telemetry/src
COPY infra/account-manager/scripts ./infra/account-manager/scripts
COPY packages/pstdio-sync-contracts/src ./packages/pstdio-sync-contracts/src
RUN bun build infra/account-manager/src/index.ts infra/account-manager/src/server.ts infra/account-manager/scripts/smoke.ts infra/account-manager/scripts/environment-verifier-smoke.ts --target bun --outdir dist

RUN bun build infra/telemetry/src/telemetry.test.ts --target bun --outfile dist/telemetry.test.js

FROM oven/bun:1.4.2
WORKDIR /app
COPY --from=build --chown=bun:bun /build/dist/telemetry.test.js ./telemetry.test.js
COPY --from=build --chown=bun:bun /build/dist/src/index.js ./authority.js
COPY --from=build --chown=bun:bun /build/dist/scripts/smoke.js ./smoke.js
COPY --from=build --chown=bun:bun /build/dist/src/server.js ./server.js
COPY --from=build --chown=bun:bun /build/dist/scripts/environment-verifier-smoke.js ./environment-verifier-smoke.js
COPY --chown=bun:bun infra/account-manager/drizzle ./drizzle
USER bun
CMD ["bun", "smoke.js"]
